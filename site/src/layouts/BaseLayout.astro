---
import "../styles/tokens.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A versioned, community-extensible catalogue of Non-Traditional Outputs (NTOs) in the Life Sciences." } = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/reforms", label: "Assessment Reforms" },
  { href: "/registry", label: "Registry" },
  { href: "/infrastructure", label: "Infrastructure" },
];

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const target = (base + href.replace(/^\//, "")).replace(/\/+$/, "") || "/";
  const current = currentPath.replace(/\/+$/, "") || "/";
  if (href === "/") return current === (base.replace(/\/+$/, "") || "/");
  return current === target || current.startsWith(target + "/");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | NTO Registry</title>
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#main">Skip to content</a>

    <header class="site-nav">
      <div class="container site-nav-inner">
        <a class="brand" href={`${base}`}>
          <img class="brand-mark" src={`${base}img/brand/nto-registry-mark.png`} alt="" width="62" height="42" />
          <span class="brand-text">NTO Registry</span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav-list" aria-label="Toggle navigation menu">
          <span class="nav-toggle-icon" aria-hidden="true"></span>
        </button>

        <nav aria-label="Primary" class="primary-nav">
          <ul class="nav-links" id="primary-nav-list">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href === "/" ? base : `${base}${item.href.replace(/^\//, "")}/`}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="footer-github" href="https://github.com/BioComputingUP/nto-registry" target="_blank" rel="noopener">
          <svg class="footer-github-icon" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          Visit the GitHub Repository
        </a>
      </div>
      <div class="container footer-bottom">
        <span>&copy; {new Date().getFullYear()} NTO Registry contributors. Content licensed CC BY 4.0.</span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const links = document.querySelector<HTMLUListElement>(".nav-links");

      toggle?.addEventListener("click", () => {
        const isOpen = links?.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
      });

      links?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          links.classList.remove("is-open");
          toggle?.setAttribute("aria-expanded", "false");
        });
      });
    </script>

    <style>
      .site-nav {
        background: var(--color-nav-bg);
        color: var(--color-nav-text);
        position: sticky;
        top: 0;
        z-index: 50;
        box-shadow: var(--shadow-sm);
      }

      .site-nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-5);
        min-height: 76px;
        padding-top: var(--space-2);
        padding-bottom: var(--space-2);
        position: relative;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        color: #fff;
        font-weight: 700;
        margin-left: -0.5rem;
      }

      .brand:hover {
        text-decoration: none;
      }

      .brand-text {
        font-size: 1.54rem;
        line-height: 1;
      }

      .brand-mark {
        display: block;
        width: 43px;
        height: 29px;
        object-fit: contain;
        flex-shrink: 0;
      }

      .primary-nav {
        flex: 1;
        display: flex;
        justify-content: flex-end;
      }

      @media (min-width: 1080px) {
        .primary-nav {
          flex: none;
          position: absolute;
          left: 50%;
          top: 50%;
          transform: translate(-50%, -50%);
        }
      }

      .nav-links {
        display: flex;
        list-style: none;
        gap: var(--space-5);
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }

      .nav-links a {
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        padding: 0.4rem 0.1rem;
        border-bottom: 2px solid transparent;
        white-space: nowrap;
      }

      .nav-links a:hover {
        color: #fff;
        text-decoration: none;
      }

      .nav-links a[aria-current="page"] {
        color: #fff;
        border-bottom-color: var(--color-accent);
      }

      .nav-toggle {
        display: none;
        width: 42px;
        height: 42px;
        padding: 0;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: var(--radius-sm);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .nav-toggle:hover {
        background: rgba(255, 255, 255, 0.08);
      }

      .nav-toggle-icon,
      .nav-toggle-icon::before,
      .nav-toggle-icon::after {
        display: block;
        width: 22px;
        height: 2px;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 2px;
        position: relative;
      }

      .nav-toggle-icon::before {
        content: "";
        position: absolute;
        top: -7px;
      }

      .nav-toggle-icon::after {
        content: "";
        position: absolute;
        top: 7px;
      }

      @media (max-width: 860px) {
        .nav-toggle {
          display: inline-flex;
        }

        .primary-nav {
          flex: none;
        }

        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          width: 100%;
          flex-direction: column;
          align-items: center;
          gap: 0;
          background: var(--color-navy-800);
          border-bottom: 3px solid var(--color-accent);
          padding: var(--space-3) var(--space-5) var(--space-4);
          box-shadow: var(--shadow-md);
        }

        .nav-links.is-open {
          display: flex;
        }

        .nav-links li {
          width: 100%;
          text-align: center;
        }

        .nav-links a {
          display: block;
          padding: var(--space-3) 0;
          border-bottom-color: transparent;
        }

        .nav-links a[aria-current="page"] {
          border-bottom-color: transparent;
        }
      }

      .site-footer {
        background: var(--color-navy-900);
        color: rgba(255, 255, 255, 0.85);
        border-top: 3px solid var(--color-accent);
      }

      .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--space-4);
        padding: var(--space-6) var(--space-5) var(--space-5);
      }

      .footer-github {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: #fff;
        font-weight: 600;
        padding: 0.55rem 1.2rem;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: var(--radius-sm);
      }

      .footer-github:hover {
        background: rgba(255, 255, 255, 0.08);
        text-decoration: none;
      }

      .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding: var(--space-3) var(--space-5);
        font-size: var(--fs-small);
        color: rgba(255, 255, 255, 0.6);
        text-align: center;
      }
    </style>
  </body>
</html>
