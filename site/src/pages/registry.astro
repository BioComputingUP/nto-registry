---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryExplorer from "../components/RegistryExplorer";
import catalogue from "../generated/ntra-catalogue.json";
import infrastructure from "../generated/infrastructure-catalogue.json";
import stats from "../generated/stats.json";

const infrastructureNames: Record<string, string> = Object.fromEntries(
  infrastructure.map((i) => [i.id, i.name])
);
---

<BaseLayout title="Registry" description="Browse and filter all Non-Traditional Research Artefact types, with examples and supporting infrastructure.">
  <section class="section page-header-section">
    <div class="container">
      <p class="eyebrow">Catalogue v{stats.catalogueVersion}</p>
      <h1>Non-Traditional Research Artefact Registry</h1>
      <p class="section-intro" style="margin-left:0;">
        All {stats.artefactCount} non-traditional research artefact types across {stats.categoryCount} categories.
        You can search, filter by category, or filter by whether credit-capture infrastructure is already active
        or still planned.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <RegistryExplorer client:load artefacts={catalogue.artefacts} categories={stats.categories} infrastructureNames={infrastructureNames} />
    </div>
  </section>
</BaseLayout>
