---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegistryExplorer from "../components/RegistryExplorer";
import catalogue from "../generated/nto-catalogue.json";
import infrastructure from "../generated/infrastructure-catalogue.json";
import stats from "../generated/stats.json";

const infrastructureInfo: Record<string, { name: string; url: string }> = Object.fromEntries(
  infrastructure.map((i) => [i.id, { name: i.name, url: i.url }])
);

// Registry cards must ingest supporting infrastructure 1:1 from the
// Infrastructure page's Publishing & Persistent Identifier Provision
// cards ONLY — the same tier-derivation logic as infrastructure.astro's
// functionKeyOf(), so both pages always agree by construction rather than
// via a hand-maintained id list.
const pidInfraIds: string[] = infrastructure
  .filter((i) => i.function.split(".")[0].trim() === "Publishing & PID provision")
  .map((i) => i.id);
---

<BaseLayout title="Registry" description="Browse and filter all Non-Traditional Output types, with examples and supporting infrastructure.">
  <section class="section page-header-section">
    <div class="container">
      <div class="registry-title-row">
        <div>
          <p class="eyebrow">Catalogue v{stats.catalogueVersion}</p>
          <h1>Non-Traditional Output Registry</h1>
          <p class="section-intro" style="margin-left:0;">
            All {stats.artefactCount} non-traditional output types across {stats.categoryCount} categories.
            You can search, filter by category, or filter by whether active credit-capture infrastructure exists.
          </p>
        </div>
        <div class="registry-hero-badge" aria-hidden="true">
          <svg viewBox="0 0 260 240" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <circle cx="196" cy="56" r="52" fill="var(--color-teal-500)" opacity="0.14" />
            <circle cx="44" cy="184" r="40" fill="var(--color-accent)" opacity="0.12" />
            <circle cx="232" cy="192" r="20" fill="var(--color-teal-500)" opacity="0.18" />
            <circle cx="18" cy="26" r="16" fill="var(--color-navy-700)" opacity="0.1" />

            <g transform="translate(34,24)">
              <rect width="192" height="192" rx="30" fill="var(--color-surface)" stroke="var(--color-border)" />
              <g transform="translate(48,48) scale(4)" stroke="var(--color-teal-500)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                <path d="M2 12l10 5 10-5" />
                <path d="M2 17l10 5 10-5" />
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section registry-explorer-section">
    <div class="container">
      <RegistryExplorer client:load artefacts={catalogue.artefacts} categories={stats.categories} infrastructureInfo={infrastructureInfo} pidInfraIds={pidInfraIds} />
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <h2>Know of an output type missing from this list?</h2>
      <p>
        Propose a new example, a new artefact type, or a correction to an existing entry.
      </p>
      <a class="btn btn-primary" href="https://github.com/BioComputingUP/nto-registry/issues/new?template=submit_nto.yml" target="_blank" rel="noopener">
        Submit new non-traditional output
      </a>
    </div>
  </section>

  <style>
    .registry-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .registry-hero-badge {
      flex-shrink: 0;
      width: 190px;
    }

    .registry-hero-badge svg {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 820px) {
      .registry-hero-badge {
        display: none;
      }
    }

    .registry-explorer-section {
      padding-top: var(--space-6);
    }

    .cta-section {
      text-align: center;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .cta-inner {
      max-width: 600px;
      margin: 0 auto;
    }
  </style>
</BaseLayout>
