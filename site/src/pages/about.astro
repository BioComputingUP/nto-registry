---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ICONS, GITHUB_ICON, WHITE_ICONS } from "../lib/icons";

const base = import.meta.env.BASE_URL;

interface Author {
  name: string;
  affiliation: string;
  role?: string;
  orcid?: string;
  photo?: string;
}

function initials(name: string) {
  return name
    .split(" ")
    .filter((p) => /^[A-Z]/.test(p))
    .map((p) => p[0])
    .join("")
    .slice(0, 3);
}

// Author list mirrors the paper's byline order. Photo credit: reused from
// BioComputingUP/OSAI_ecosystem's about page for the two authors who overlap
// with that project's team. ORCID iDs are independently verified via the
// public ORCID API (https://pub.orcid.org), cross-checked against each
// person's listed employer/works to confirm the match — see AGENTS.md's
// "never fabricate a URL/identifier" rule. Verification notes:
//   - Alloza, Zoubiri: single unambiguous ORCID match with employment record
//     at the exact institution listed in the paper.
//   - Hermjakob, Makaronidou, Quaglia, Capella-Gutierrez, Goble, Sufi,
//     Vergoulis: single unambiguous match, institution matches the paper.
//   - Bouhraoua: single ORCID record for this surname; credit-name matches
//     exactly, and its listed works (DisProt, CAID) are the same Padova
//     bioinformatics group's projects.
//   - Andrew Smith: a common name (284 ORCID records), disambiguated via
//     employment record "Head of External Relations @ ELIXIR, Hinxton, GB" —
//     an exact match to the paper's ELIXIR Europe Hub / Hinxton affiliation.
const authors: Author[] = [
  {
    name: "Gavin Farrell",
    affiliation: "University of Padova, Italy",
    role: "Lead author & registry maintainer",
    orcid: "0000-0001-5166-8551",
    photo: "img/authors/gavin.jpeg",
  },
  {
    name: "Eva Alloza",
    affiliation: "Barcelona Supercomputing Center (BSC), Spain",
    orcid: "0000-0001-8385-9336",
  },
  {
    name: "Adel Bouhraoua",
    affiliation: "University of Padova, Italy",
    orcid: "0000-0001-9531-6339",
  },
  {
    name: "Salvador Capella-Gutierrez",
    affiliation: "Barcelona Supercomputing Center (BSC), Spain",
    orcid: "0000-0002-0309-604X",
  },
  {
    name: "Carole Goble",
    affiliation: "University of Manchester, United Kingdom",
    orcid: "0000-0003-1219-2137",
  },
  {
    name: "Henning Hermjakob",
    affiliation: "EMBL-EBI, United Kingdom",
    orcid: "0000-0001-8479-0262",
  },
  {
    name: "Maria Makaronidou",
    affiliation: "Athena Research & Innovation Center, Greece",
    orcid: "0009-0006-4575-3526",
  },
  {
    name: "Andrew Smith",
    affiliation: "ELIXIR Europe Hub, EMBL-EBI, United Kingdom",
    orcid: "0000-0002-6025-9271",
  },
  {
    name: "Shoaib Sufi",
    affiliation: "University of Manchester, United Kingdom",
    orcid: "0000-0001-6390-2616",
  },
  {
    name: "Thanasis Vergoulis",
    affiliation: "Athena Research & Innovation Center, Greece",
    orcid: "0000-0003-0555-4128",
  },
  {
    name: "Mehdi Zoubiri",
    affiliation: "University of Padova, Italy",
    orcid: "0009-0009-3602-3558",
  },
  {
    name: "Federica Quaglia",
    affiliation: "University of Padova, Italy",
    role: "Co-corresponding author",
    orcid: "0000-0002-0341-4888",
  },
  {
    name: "Silvio C.E. Tosatto",
    affiliation: "University of Padova, Italy / CNR-IBIOM, Italy",
    role: "Co-corresponding author",
    orcid: "0000-0003-4525-7793",
    photo: "img/authors/silvio-tosatto.jpg",
  },
];
---

<BaseLayout title="About" description="The paper, authors, and ELIXIR Europe community behind the NTO Registry.">
  <section class="section page-header-section">
    <div class="container">
      <div class="about-title-row">
        <div>
          <p class="eyebrow">About</p>
          <h1>The paper behind this work</h1>
          <p class="section-intro about-lede" style="margin-left:0;">
            This registry operationalises the landscaping presented in a preprint from members
            of the ELIXIR Europe community.
          </p>
        </div>
        <div class="about-hero-badge" aria-hidden="true">
          <svg viewBox="0 0 260 240" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <circle cx="196" cy="56" r="52" fill="var(--color-teal-500)" opacity="0.14" />
            <circle cx="44" cy="184" r="40" fill="var(--color-accent)" opacity="0.12" />
            <circle cx="232" cy="192" r="20" fill="var(--color-teal-500)" opacity="0.18" />
            <circle cx="18" cy="26" r="16" fill="var(--color-navy-700)" opacity="0.1" />

            <g transform="translate(34,24)">
              <rect width="192" height="192" rx="30" fill="var(--color-surface)" stroke="var(--color-border)" />
              <g transform="translate(48,48) scale(4)" stroke="var(--color-accent)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 6c-2-1.3-5-1.7-8-1v13c3-.7 6-.3 8 1 2-1.3 5-1.7 8-1V5c-3-.7-6-.3-8 1Zm0 0v13" />
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section preprint-section">
    <div class="container">
      <p class="eyebrow">Preprint</p>
      <h2>Credit, recognition, and reward for non-traditional research outputs<br />in the Life Sciences</h2>
      <div class="preprint-layout">
        <p>
          Publication metrics remain the primary academic performance assessment in modern
          academia, leaving a gap in recognition for impactful non-traditional
          outputs such as curated datasets, research software, and training materials.
          Through a mapping of valuable non-traditional outputs illustrated by Life Science
          examples from ELIXIR Europe, this paper examines the technical solutions and
          sociological barriers to credit, recognition, and reward — the landscaping this
          registry hosts as versioned, machine-readable data.
        </p>
        <div class="preprint-cta-col">
          <div class="preprint-cta-badge" aria-hidden="true">
            <img src={`${base}img/logos/metaarxiv.png`} alt="" width="120" height="117" loading="lazy" />
          </div>
          <a class="btn btn-primary preprint-cta" href="https://osf.io/preprints/metaarxiv/praxg_v1" target="_blank" rel="noopener">
            <span class="btn-icon" set:html={WHITE_ICONS.book} />
            Read the Preprint on OSF (MetaArXiv)
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container">
      <h2 class="section-heading authors-heading" style="text-align:center;">Authors</h2>
      <div class="grid grid-4">
        {authors.map((author) => (
          <div class="card author-card author-card-aligned">
            {author.photo ? (
              <img class="author-photo" src={`${base}${author.photo}`} alt={author.name} loading="lazy" />
            ) : (
              <div class="author-initials" aria-hidden="true">{initials(author.name)}</div>
            )}
            <h4 class="author-name">{author.name}</h4>
            {author.role && <p class="author-role">{author.role}</p>}
            <p class:list={["author-affiliation", !author.role && "author-affiliation-float"]}>{author.affiliation}</p>
            {author.orcid && (
              <a href={`https://orcid.org/${author.orcid}`} target="_blank" rel="noopener" class="orcid-link" aria-label={`${author.name}'s ORCID iD`} title="View ORCID iD">
                <img src="https://orcid.org/assets/vectors/orcid.logo.icon.svg" alt="" width="20" height="20" loading="lazy" />
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div class="card contact-card">
          <div class="contact-card-head">
            <span class="contact-card-icon" set:html={ICONS.users} />
            <h3>ELIXIR CRU Focus Group</h3>
          </div>
          <p>
            This work is carried out in collaboration with the ELIXIR Europe Credit,
            Recognition & Usage Focus Group, which brings together the wider community
            working on these challenges.
          </p>
          <a class="btn btn-outline" href="https://elixir-europe.org/focus-groups/credit-recognition-usage" target="_blank" rel="noopener">
            Visit the focus group
          </a>
        </div>
        <div class="card contact-card">
          <div class="contact-card-head">
            <span class="contact-card-icon" set:html={GITHUB_ICON} />
            <h3>The Registry on GitHub</h3>
          </div>
          <p>
            The data behind this site — the output catalogue, infrastructure catalogue,
            and reform initiatives — is versioned and openly maintained on GitHub.
            Contributions are welcome.
          </p>
          <a class="btn btn-outline" href="https://github.com/BioComputingUP/nto-registry" target="_blank" rel="noopener">
            View the repository
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .about-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .about-hero-badge {
      flex-shrink: 0;
      width: 190px;
    }

    .about-hero-badge svg {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 820px) {
      .about-hero-badge {
        display: none;
      }
    }

    .about-lede {
      max-width: none;
    }

    @media (min-width: 700px) {
      .about-lede {
        white-space: nowrap;
      }
    }

    .preprint-section h2 {
      max-width: none;
    }

    .preprint-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: var(--space-7);
      align-items: end;
      margin-top: var(--space-2);
    }

    .preprint-layout p {
      max-width: 620px;
      margin-bottom: 0;
    }

    .preprint-cta-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
    }

    .preprint-cta-badge {
      width: 108px;
    }

    .preprint-cta-badge img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 50%;
      box-shadow: var(--shadow-sm);
    }

    .preprint-cta {
      white-space: nowrap;
    }

    @media (max-width: 780px) {
      .preprint-layout {
        grid-template-columns: 1fr;
      }

      .preprint-cta-col {
        align-items: flex-start;
      }

      .preprint-cta-badge {
        display: none;
      }
    }

    .btn-icon {
      display: inline-flex;
    }

    .btn-icon :global(svg) {
      width: 18px;
      height: 18px;
    }

    .authors-heading {
      margin-bottom: var(--space-6);
    }

    .contact-card-head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .contact-card-head h3 {
      margin: 0;
    }

    .contact-card-icon {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--color-accent);
    }

    .contact-card-icon :global(svg) {
      width: 28px;
      height: 28px;
    }

    .author-card-aligned {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* For authors with no role line, float the affiliation text midway in
       the leftover space between the name and the ORCID icon at the
       bottom, instead of it sitting flush under the name with all the
       dead space pushed below it. Authors with a role keep the tighter
       name/role/affiliation stack (unchanged) since that already reads
       fine as a compact block. */
    .author-affiliation-float {
      margin-top: auto;
      margin-bottom: auto;
    }

    .orcid-link {
      display: inline-flex;
      margin-top: auto;
      padding-top: var(--space-2);
    }

    .orcid-link img {
      opacity: 0.85;
      transition: opacity 0.15s ease;
    }

    .orcid-link:hover img {
      opacity: 1;
    }
  </style>
</BaseLayout>
