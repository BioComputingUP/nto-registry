---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ICONS, GITHUB_ICON, WHITE_ICONS } from "../lib/icons";
import stats from "../generated/stats.json";

const base = import.meta.env.BASE_URL;

interface Author {
  name: string;
  affiliation: string;
  role?: string;
  orcid?: string;
  photo?: string;
}

function initials(name: string) {
  return name
    .split(" ")
    .filter((p) => /^[A-Z]/.test(p))
    .map((p) => p[0])
    .join("")
    .slice(0, 3);
}

// Author list mirrors the paper's byline order. Photo credit: reused from
// BioComputingUP/OSAI_ecosystem's about page for the two authors who overlap
// with that project's team. ORCID iDs are independently verified via the
// public ORCID API (https://pub.orcid.org), cross-checked against each
// person's listed employer/works to confirm the match — see AGENTS.md's
// "never fabricate a URL/identifier" rule. Verification notes:
//   - Alloza, Zoubiri: single unambiguous ORCID match with employment record
//     at the exact institution listed in the paper.
//   - Hermjakob, Makaronidou, Quaglia, Capella-Gutierrez, Goble, Sufi,
//     Vergoulis: single unambiguous match, institution matches the paper.
//   - Bouhraoua: single ORCID record for this surname; credit-name matches
//     exactly, and its listed works (DisProt, CAID) are the same Padova
//     bioinformatics group's projects.
//   - Andrew Smith: a common name (284 ORCID records), disambiguated via
//     employment record "Head of External Relations @ ELIXIR, Hinxton, GB" —
//     an exact match to the paper's ELIXIR Europe Hub / Hinxton affiliation.
const authors: Author[] = [
  {
    name: "Gavin Farrell",
    affiliation: "University of Padova, Italy",
    role: "Lead author & registry maintainer",
    orcid: "0000-0001-5166-8551",
    photo: "img/authors/gavin.jpeg",
  },
  {
    name: "Eva Alloza",
    affiliation: "Barcelona Supercomputing Center (BSC), Spain",
    orcid: "0000-0001-8385-9336",
  },
  {
    name: "Adel Bouhraoua",
    affiliation: "University of Padova, Italy",
    orcid: "0000-0001-9531-6339",
  },
  {
    name: "Salvador Capella-Gutierrez",
    affiliation: "Barcelona Supercomputing Center (BSC), Spain",
    orcid: "0000-0002-0309-604X",
  },
  {
    name: "Carole Goble",
    affiliation: "University of Manchester, United Kingdom",
    orcid: "0000-0003-1219-2137",
  },
  {
    name: "Henning Hermjakob",
    affiliation: "EMBL-EBI, United Kingdom",
    orcid: "0000-0001-8479-0262",
  },
  {
    name: "Maria Makaronidou",
    affiliation: "Athena Research & Innovation Center, Greece",
    orcid: "0009-0006-4575-3526",
  },
  {
    name: "Andrew Smith",
    affiliation: "ELIXIR Europe Hub, EMBL-EBI, United Kingdom",
    orcid: "0000-0002-6025-9271",
  },
  {
    name: "Shoaib Sufi",
    affiliation: "University of Manchester, United Kingdom",
    orcid: "0000-0001-6390-2616",
  },
  {
    name: "Thanasis Vergoulis",
    affiliation: "Athena Research & Innovation Center, Greece",
    orcid: "0000-0003-0555-4128",
  },
  {
    name: "Mehdi Zoubiri",
    affiliation: "University of Padova, Italy",
    orcid: "0009-0009-3602-3558",
  },
  {
    name: "Federica Quaglia",
    affiliation: "University of Padova, Italy",
    role: "Co-corresponding author",
    orcid: "0000-0002-0341-4888",
  },
  {
    name: "Silvio C.E. Tosatto",
    affiliation: "University of Padova, Italy / CNR-IBIOM, Italy",
    role: "Co-corresponding author",
    orcid: "0000-0003-4525-7793",
    photo: "img/authors/silvio-tosatto.jpg",
  },
];

// --- Citation ------------------------------------------------------------
// Transcribed from the registered Crossref record for the DOI
// (api.crossref.org/works/10.31222/osf.io/praxg_v1): title, author order,
// posted date, server and licence are the record as posted in v1. It reads
// "artefacts" where this page's heading says "outputs", and its byline is 12
// authors to the Authors grid's 13 — both reconcile when a v2 is posted (see
// CITATION.cff's `notes`). A citation must match what the DOI resolves to,
// so this block stays with the posted record. Don't hand-edit the DOI, date
// or byline without re-checking Crossref.
const preprint = {
  doi: "10.31222/osf.io/praxg_v1",
  doiUrl: "https://doi.org/10.31222/osf.io/praxg_v1",
  posted: "10 March 2026",
  server: "MetaArXiv",
  license: "CC BY-ND 4.0",
};

const preprintReference =
  "Farrell, G., Alloza, E., Bouhraoua, A., Capella-Gutierrez, S., Goble, C., " +
  "Hermjakob, H., Smith, A., Sufi, S., Vergoulis, T., Zoubiri, M., Quaglia, F., " +
  "& Tosatto, S. C. E. (2026). Credit, recognition, and reward for " +
  "non-traditional research artefacts in the Life Sciences [Preprint]. " +
  `MetaArXiv. ${preprint.doiUrl}`;

const preprintBibtex = `@misc{farrell2026credit,
  author = {Farrell, Gavin and Alloza, Eva and
    Bouhraoua, Adel and Capella-Gutierrez, Salvador and
    Goble, Carole and Hermjakob, Henning and
    Smith, Andrew and Sufi, Shoaib and
    Vergoulis, Thanasis and Zoubiri, Mehdi and
    Quaglia, Federica and Tosatto, Silvio C. E.},
  title = {{Credit, recognition, and reward for
    non-traditional research artefacts in the
    Life Sciences}},
  year = {2026},
  month = mar,
  publisher = {Center for Open Science},
  howpublished = {MetaArXiv preprint},
  doi = {10.31222/osf.io/praxg_v1},
  url = {https://doi.org/10.31222/osf.io/praxg_v1}
}`;

// --- Archive -------------------------------------------------------------
// Zenodo mints two DOIs for an archived repository: a *version* DOI unique to
// each release, and a *concept* DOI that is stable forever and always
// resolves to the newest version. Only the concept DOI is hardcoded here —
// the displayed version and every count below are read from stats.json (i.e.
// from data/*.yml), so cutting a new release needs no edit to this page.
// Never paste a version DOI here; it goes stale one release later. The
// `cut-release` skill states this as a hard rule.
const ZENODO_CONCEPT_DOI = "10.5281/zenodo.22306726";
const ZENODO_DOI_URL = `https://doi.org/${ZENODO_CONCEPT_DOI}`;
const ZENODO_ALL_VERSIONS_URL = ZENODO_DOI_URL;
const GITHUB_RELEASES_URL = "https://github.com/BioComputingUP/nto-registry/releases";

// The registry's primary assets are three curated YAML files — the catalogue
// itself, not a by-product of the website. Counts come from stats.json so
// this grid can't drift from data/*.yml.
const archivedData = [
  {
    file: "nto_catalogue.yml",
    icon: "database",
    colorVar: "--cat-data",
    count: stats.artefactCount,
    unit: "artefact types",
    blurb:
      "Every artefact type with its explanation, the activities that produce it, real Life Science examples, and the infrastructure that can capture credit for it.",
  },
  {
    file: "infrastructure_catalogue.yml",
    icon: "server",
    colorVar: "--cat-software",
    count: stats.infrastructureCount,
    unit: "platforms",
    blurb:
      "The normalized registry of credit-capturing platforms referenced by the catalogue, each cross-walked onto the CoARA OI4RRA four-tier architecture.",
  },
  {
    file: "reform_initiatives.yml",
    icon: "flag",
    colorVar: "--cat-research-support",
    count: stats.reformInitiativeCount,
    unit: "initiatives",
    blurb:
      "The international research assessment reform initiatives — DORA, CoARA, Hidden REF and others — and what each means for non-traditional outputs.",
  },
];
---

<BaseLayout title="About" description="The paper, authors, and ELIXIR Europe community behind the NTO Registry.">
  <section class="section page-header-section">
    <div class="container">
      <div class="about-title-row">
        <div>
          <p class="eyebrow">About</p>
          <h1>The paper behind this work</h1>
          <p class="section-intro about-lede" style="margin-left:0;">
            This registry operationalises the landscaping presented in a preprint from members
            of the ELIXIR Europe community.
          </p>
        </div>
        <div class="about-hero-badge" aria-hidden="true">
          <svg viewBox="0 0 260 240" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <circle cx="196" cy="56" r="52" fill="var(--color-teal-500)" opacity="0.14" />
            <circle cx="44" cy="184" r="40" fill="var(--color-accent)" opacity="0.12" />
            <circle cx="232" cy="192" r="20" fill="var(--color-teal-500)" opacity="0.18" />
            <circle cx="18" cy="26" r="16" fill="var(--color-navy-700)" opacity="0.1" />

            <g transform="translate(34,24)">
              <rect width="192" height="192" rx="30" fill="var(--color-surface)" stroke="var(--color-border)" />
              <g transform="translate(48,48) scale(4)" stroke="var(--color-accent)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 6c-2-1.3-5-1.7-8-1v13c3-.7 6-.3 8 1 2-1.3 5-1.7 8-1V5c-3-.7-6-.3-8 1Zm0 0v13" />
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section preprint-section">
    <div class="container">
      <p class="eyebrow">Preprint</p>
      <h2>Credit, recognition, and reward for non-traditional research outputs<br />in the Life Sciences</h2>
      <div class="preprint-layout">
        <p>
          Publication metrics remain the primary academic performance assessment in modern
          academia, leaving a gap in recognition for impactful non-traditional
          outputs such as curated datasets, research software, and training materials.
          Through a mapping of valuable non-traditional outputs illustrated by Life Science
          examples from ELIXIR Europe, this paper examines the technical solutions and
          sociological barriers to credit, recognition, and reward — the landscaping this
          registry hosts as versioned, machine-readable data.
        </p>
        <div class="preprint-cta-col">
          <div class="preprint-cta-badge" aria-hidden="true">
            <img src={`${base}img/logos/metaarxiv.png`} alt="" width="120" height="117" loading="lazy" />
          </div>
          <a class="btn btn-primary preprint-cta" href="https://osf.io/preprints/metaarxiv/praxg_v1" target="_blank" rel="noopener">
            <span class="btn-icon" set:html={WHITE_ICONS.book} />
            Read the Preprint on OSF (MetaArXiv)
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container">
      <h2 class="section-heading authors-heading" style="text-align:center;">Authors</h2>
      <div class="grid grid-4">
        {authors.map((author) => (
          <div class="card author-card author-card-aligned">
            {author.photo ? (
              <img class="author-photo" src={`${base}${author.photo}`} alt={author.name} loading="lazy" />
            ) : (
              <div class="author-initials" aria-hidden="true">{initials(author.name)}</div>
            )}
            <h4 class="author-name">{author.name}</h4>
            {author.role && <p class="author-role">{author.role}</p>}
            <p class:list={["author-affiliation", !author.role && "author-affiliation-float"]}>{author.affiliation}</p>
            {author.orcid && (
              <a href={`https://orcid.org/${author.orcid}`} target="_blank" rel="noopener" class="orcid-link" aria-label={`${author.name}'s ORCID iD`} title="View ORCID iD">
                <img src="https://orcid.org/assets/vectors/orcid.logo.icon.svg" alt="" width="20" height="20" loading="lazy" />
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cite-section" id="cite">
    <div class="container">
      <p class="eyebrow">Citation</p>
      <h2 class="cite-heading">Cite this preprint</h2>
      <blockquote class="cite-reference" id="cite-reference">{preprintReference}</blockquote>
      <div class="cite-actions">
        <button class="cite-copy" type="button" data-copy-target="cite-reference" data-copy-label="Copy reference">
          <span class="cite-copy-text" aria-live="polite">Copy reference</span>
        </button>
        <button class="cite-copy" type="button" data-copy-target="cite-bibtex" data-copy-label="Copy BibTeX">
          <span class="cite-copy-text" aria-live="polite">Copy BibTeX</span>
        </button>
        <p class="cite-facts">
          <a href={preprint.doiUrl} target="_blank" rel="noopener">{preprint.doi}</a> · {preprint.posted} · {preprint.server} · {preprint.license}
        </p>
      </div>
      <pre id="cite-bibtex" hidden>{preprintBibtex}</pre>
    </div>
  </section>

  <section class="section archive-section" id="archive">
    <div class="container">
      <p class="eyebrow">Archive</p>
      <h2 class="archive-heading">Cite a fixed version of the registry</h2>
      <p class="archive-lede">
        Every release is deposited in <a href="https://zenodo.org/" target="_blank" rel="noopener">Zenodo</a> with a
        permanent DOI, so the catalogue can be cited at an exact version and reused from a snapshot that will never
        change underneath you. The DOI below is the <strong>concept DOI</strong> — it is stable across all releases and
        always resolves to the most recent one.
      </p>

      <div class="archive-doi-card">
        <a class="archive-doi-logo" href={ZENODO_DOI_URL} target="_blank" rel="noopener" aria-label="This registry on Zenodo">
          <img src={`${base}img/logos/zenodo.svg`} alt="Zenodo" width="110" height="40" loading="lazy" />
        </a>
        <div class="archive-doi-body">
          <p class="archive-doi-label">All versions · concept DOI</p>
          <a class="archive-doi-value" id="archive-doi" href={ZENODO_DOI_URL} target="_blank" rel="noopener">{ZENODO_CONCEPT_DOI}</a>
          <p class="archive-doi-meta">Latest release v{stats.catalogueVersion} · Dataset · CC BY 4.0</p>
        </div>
        <button class="cite-copy archive-doi-copy" type="button" data-copy-target="archive-doi" data-copy-label="Copy DOI">
          <span class="cite-copy-text" aria-live="polite">Copy DOI</span>
        </button>
      </div>

      <h3 class="archive-subhead">What's archived</h3>
      <p class="archive-subnote">
        The registry's primary assets are three curated YAML files. They are the catalogue itself — designed for direct
        reuse, adaptation to other research domains, and machine consumption — not a by-product of this website.
      </p>

      <div class="grid grid-3 archive-assets">
        {archivedData.map((asset) => (
          <div class="card archive-asset" style={`--asset-color: var(${asset.colorVar});`}>
            <span class="archive-asset-icon" set:html={ICONS[asset.icon]} />
            <p class="archive-asset-count">
              {asset.count}<span class="archive-asset-unit">{asset.unit}</span>
            </p>
            <code class="archive-asset-file">data/{asset.file}</code>
            <p class="archive-asset-blurb">{asset.blurb}</p>
          </div>
        ))}
      </div>

      <div class="archive-software">
        <span class="archive-software-icon" set:html={ICONS.code} />
        <p>
          <strong>Supporting software is archived alongside the data, not in place of it.</strong> The same snapshot
          carries <code>site/</code>, the Astro and React application that publishes this catalogue, and{" "}
          <code>scripts/validate_yaml.py</code>, the schema and reference-integrity validator run against every change.
        </p>
      </div>

      <div class="archive-actions">
        <a class="btn btn-outline" href={ZENODO_ALL_VERSIONS_URL} target="_blank" rel="noopener">View all versions on Zenodo</a>
        <a class="btn btn-outline" href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">Release history on GitHub</a>
      </div>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container">
      <div class="grid grid-2">
        <div class="card contact-card">
          <div class="contact-card-head">
            <span class="contact-card-icon" set:html={ICONS.users} />
            <h3>ELIXIR CRU Focus Group</h3>
          </div>
          <p>
            This work is carried out in collaboration with the ELIXIR Europe Credit,
            Recognition & Usage Focus Group, which brings together the wider community
            working on these challenges.
          </p>
          <a class="btn btn-outline" href="https://elixir-europe.org/focus-groups/credit-recognition-usage" target="_blank" rel="noopener">
            Visit the focus group
          </a>
        </div>
        <div class="card contact-card">
          <div class="contact-card-head">
            <span class="contact-card-icon" set:html={GITHUB_ICON} />
            <h3>The Registry on GitHub</h3>
          </div>
          <p>
            The data behind this site — the output catalogue, infrastructure catalogue,
            and reform initiatives — is versioned and openly maintained on GitHub.
            Contributions are welcome.
          </p>
          <a class="btn btn-outline" href="https://github.com/BioComputingUP/nto-registry" target="_blank" rel="noopener">
            View the repository
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .about-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .about-hero-badge {
      flex-shrink: 0;
      width: 190px;
    }

    .about-hero-badge svg {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 820px) {
      .about-hero-badge {
        display: none;
      }
    }

    .about-lede {
      max-width: none;
    }

    @media (min-width: 700px) {
      .about-lede {
        white-space: nowrap;
      }
    }

    .preprint-section h2 {
      max-width: none;
    }

    .preprint-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: var(--space-7);
      align-items: end;
      margin-top: var(--space-2);
    }

    .preprint-layout p {
      max-width: 620px;
      margin-bottom: 0;
    }

    .preprint-cta-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
    }

    .preprint-cta-badge {
      width: 108px;
    }

    .preprint-cta-badge img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 50%;
      box-shadow: var(--shadow-sm);
    }

    .preprint-cta {
      white-space: nowrap;
    }

    @media (max-width: 780px) {
      .preprint-layout {
        grid-template-columns: 1fr;
      }

      .preprint-cta-col {
        align-items: flex-start;
      }

      .preprint-cta-badge {
        display: none;
      }
    }

    .btn-icon {
      display: inline-flex;
    }

    .btn-icon :global(svg) {
      width: 18px;
      height: 18px;
    }

    .authors-heading {
      margin-bottom: var(--space-6);
    }

    .contact-card-head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .contact-card-head h3 {
      margin: 0;
    }

    .contact-card-icon {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--color-accent);
    }

    .contact-card-icon :global(svg) {
      width: 28px;
      height: 28px;
    }

    .author-card-aligned {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* For authors with no role line, float the affiliation text midway in
       the leftover space between the name and the ORCID icon at the
       bottom, instead of it sitting flush under the name with all the
       dead space pushed below it. Authors with a role keep the tighter
       name/role/affiliation stack (unchanged) since that already reads
       fine as a compact block. */
    .author-affiliation-float {
      margin-top: auto;
      margin-bottom: auto;
    }

    .orcid-link {
      display: inline-flex;
      margin-top: auto;
      padding-top: var(--space-2);
    }

    .orcid-link img {
      opacity: 0.85;
      transition: opacity 0.15s ease;
    }

    .orcid-link:hover img {
      opacity: 1;
    }
    /* Its own band between the subtle Authors and closing sections, so the
       citation reads as a separate step rather than a trailing note. */
    .cite-section {
      padding: var(--space-7) 0;
    }

    .cite-heading {
      margin-bottom: var(--space-4);
    }

    .cite-reference {
      max-width: 780px;
      margin: 0 0 var(--space-4);
      padding: var(--space-4);
      border-left: 3px solid var(--color-accent);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      background: var(--color-bg-subtle);
      font-size: var(--fs-small);
      line-height: 1.65;
    }

    .cite-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .cite-copy {
      padding: 0.4rem 0.85rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      color: var(--color-text-muted);
      font-family: inherit;
      font-size: var(--fs-small);
      font-weight: 600;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .cite-copy:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
    }

    .cite-copy[data-copied="true"] {
      color: var(--color-badge-active-text);
      border-color: var(--color-badge-active-text);
    }

    .cite-facts {
      margin: 0;
      font-size: var(--fs-small);
      color: var(--color-text-muted);
    }

    /* The Citation band above sits on the default background and the contact
       cards below are .section-subtle, so a second tinted band here would
       merge into that one. A hairline rule separates this step instead, and
       the DOI card carries the fill. */
    .archive-section {
      padding: var(--space-7) 0;
      border-top: 1px solid var(--color-border);
      /* Clear the sticky header when arriving via /about#archive. */
      scroll-margin-top: 90px;
    }

    .archive-heading {
      margin-bottom: var(--space-3);
    }

    .archive-lede {
      max-width: 780px;
      margin-bottom: var(--space-5);
    }

    .archive-doi-card {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-5);
      max-width: 780px;
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--color-accent);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      background: var(--color-bg-subtle);
    }

    /* The Zenodo mark is a blue gradient tile with a white wordmark, so it
       reads on both the light and dark surface without inversion. */
    .archive-doi-logo {
      display: block;
      flex-shrink: 0;
    }

    .archive-doi-logo img {
      display: block;
      width: 110px;
      height: auto;
      border-radius: var(--radius-sm);
    }

    .archive-doi-body {
      flex: 1 1 240px;
      min-width: 0;
    }

    .archive-doi-label {
      margin: 0 0 var(--space-1);
      font-size: var(--fs-small);
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .archive-doi-value {
      display: inline-block;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 1.05rem;
