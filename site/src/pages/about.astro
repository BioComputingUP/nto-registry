  <script>
    // Copy-to-clipboard for the citation blocks. Each button names the element
    // holding the text via data-copy-target; the label swaps for a moment and
    // data-copied drives the button's success colour.
    document.querySelectorAll(".cite-copy").forEach((button) => {
      const label = button.querySelector(".cite-copy-text");
      const target = document.getElementById(button.dataset.copyTarget || "");
      if (!label || !target) return;

      const reset = () => {
        label.textContent = button.dataset.copyLabel || "Copy";
        delete button.dataset.copied;
      };

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText((target.textContent || "").trim());
          label.textContent = "Copied";
          button.dataset.copied = "true";
        } catch {
          // Clipboard access can be refused (insecure context, or the user's
          // browser permissions) — say so rather than claiming success.
          label.textContent = "Copy failed — select the text";
        }
        window.setTimeout(reset, 2500);
      });
    });
  </script>
