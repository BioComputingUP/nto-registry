---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ICONS, GITHUB_ICON, WHITE_ICONS } from "../lib/icons";
import stats from "../generated/stats.json";

const base = import.meta.env.BASE_URL;

interface Author {
  name: string;
  affiliation: string;
  role?: string;
  orcid?: string;
  photo?: string;
}

function initials(name: string) {
  return name
    .split(" ")
    .filter((p) => /^[A-Z]/.test(p))
    .map((p) => p[0])
    .join("")
    .slice(0, 3);
}

// Author list mirrors the paper's byline order. Photo credit: reused from
// BioComputingUP/OSAI_ecosystem's about page for the two authors who overlap
// with that project's team. ORCID iDs are independently verified via the
// public ORCID API (https://pub.orcid.org), cross-checked against each
// person's listed employer/works to confirm the match — see AGENTS.md's
// "never fabricate a URL/identifier" rule. Verification notes:
//   - Alloza, Zoubiri: single unambiguous ORCID match with employment record
//     at the exact institution listed in the paper.
//   - Hermjakob, Makaronidou, Quaglia, Capella-Gutierrez, Goble, Sufi,
//     Vergoulis: single unambiguous match, institution matches the paper.
//   - Bouhraoua: single ORCID record for this surname; credit-name matches
//     exactly, and its listed works (DisProt, CAID) are the same Padova
//     bioinformatics group's projects.
//   - Andrew Smith: a common name (284 ORCID records), disambiguated via
//     employment record "Head of External Relations @ ELIXIR, Hinxton, GB" —
//     an exact match to the paper's ELIXIR Europe Hub / Hinxton affiliation.
const authors: Author[] = [
  {
    name: "Gavin Farrell",
    affiliation: "University of Padova, Italy",
    role: "Lead author & registry maintainer",
    orcid: "0000-0001-5166-8551",
    photo: "img/authors/gavin.jpeg",
  },
  {
    name: "Eva Alloza",
    affiliation: "Barcelona Supercomputing Center (BSC), Spain",
    orcid: "0000-0001-8385-9336",
  },
  {
    name: "Adel Bouhraoua",
    affiliation: "University of Padova, Italy",
    orcid: "0000-0001-9531-6339",
  },
  {
    name: "Salvador Capella-Gutierrez",
    affiliation: "Barcelona Supercomputing Center (BSC), Spain",
    orcid: "0000-0002-0309-604X",
  },
  {
    name: "Carole Goble",
    affiliation: "University of Manchester, United Kingdom",
    orcid: "0000-0003-1219-2137",
  },
  {
    name: "Henning Hermjakob",
    affiliation: "EMBL-EBI, United Kingdom",
    orcid: "0000-0001-8479-0262",
  },
  {
    name: "Maria Makaronidou",
    affiliation: "Athena Research & Innovation Center, Greece",
    orcid: "0009-0006-4575-3526",
  },
  {
    name: "Andrew Smith",
    affiliation: "ELIXIR Europe Hub, EMBL-EBI, United Kingdom",
    orcid: "0000-0002-6025-9271",
  },
  {
    name: "Shoaib Sufi",
    affiliation: "University of Manchester, United Kingdom",
    orcid: "0000-0001-6390-2616",
  },
  {
    name: "Thanasis Vergoulis",
    affiliation: "Athena Research & Innovation Center, Greece",
    orcid: "0000-0003-0555-4128",
  },
  {
    name: "Mehdi Zoubiri",
    affiliation: "University of Padova, Italy",
    orcid: "0009-0009-3602-3558",
  },
  {
    name: "Federica Quaglia",
    affiliation: "University of Padova, Italy",
    role: "Co-corresponding author",
    orcid: "0000-0002-0341-4888",
  },
  {
    name: "Silvio C.E. Tosatto",
    affiliation: "University of Padova, Italy / CNR-IBIOM, Italy",
    role: "Co-corresponding author",
    orcid: "0000-0003-4525-7793",
    photo: "img/authors/silvio-tosatto.jpg",
  },
];

// --- Citation data -------------------------------------------------------
// The preprint block below is transcribed from the registered Crossref record
// for DOI 10.31222/osf.io/praxg_v1 (api.crossref.org/works/10.31222/osf.io/
// praxg_v1) — title, author order, posted date, server and licence are the
// *as-posted v1* record, not the working versions used elsewhere on this
// page. Two known divergences, both expected and both reconciled when a new
// preprint version is posted (see CITATION.cff's `notes`):
//   - the posted title says "artefacts" where this page's section heading and
//     CITATION.cff say "outputs";
//   - the posted byline has 12 authors; the Authors grid above (and
//     CITATION.cff) carries 13, adding Maria Makaronidou.
// A citation must match the record it points at, so this section stays with
// the posted record until a v2 is minted. Never hand-edit the DOI, date or
// byline here without re-checking Crossref.
const preprint = {
  authors:
    "Farrell, G., Alloza, E., Bouhraoua, A., Capella-Gutierrez, S., Goble, C., " +
    "Hermjakob, H., Smith, A., Sufi, S., Vergoulis, T., Zoubiri, M., Quaglia, F., " +
    "& Tosatto, S. C. E.",
  year: "2026",
  title:
    "Credit, recognition, and reward for non-traditional research artefacts in the Life Sciences",
  doi: "10.31222/osf.io/praxg_v1",
  doiUrl: "https://doi.org/10.31222/osf.io/praxg_v1",
  osfUrl: "https://osf.io/preprints/metaarxiv/praxg_v1",
  server: "MetaArXiv",
  publisher: "Center for Open Science",
  posted: "10 March 2026",
  version: "Version 1",
  license: "CC BY-ND 4.0",
};

const preprintReference = `${preprint.authors} (${preprint.year}). ${preprint.title} [Preprint]. ${preprint.server}. ${preprint.doiUrl}`;

const preprintBibtex = `@misc{farrell2026credit,
  author = {Farrell, Gavin and Alloza, Eva and
    Bouhraoua, Adel and Capella-Gutierrez, Salvador and
    Goble, Carole and Hermjakob, Henning and
    Smith, Andrew and Sufi, Shoaib and
    Vergoulis, Thanasis and Zoubiri, Mehdi and
    Quaglia, Federica and Tosatto, Silvio C. E.},
  title = {{Credit, recognition, and reward for
    non-traditional research artefacts in the
    Life Sciences}},
  year = {2026},
  month = mar,
  publisher = {Center for Open Science},
  howpublished = {MetaArXiv preprint},
  doi = {10.31222/osf.io/praxg_v1},
  url = {https://doi.org/10.31222/osf.io/praxg_v1}
}`;

// The registry citation tracks CITATION.cff. `version` is read from the
// generated stats so a `semver-maintenance` bump flows through here
// automatically; the release year mirrors CITATION.cff's `date-released`.
const registry = {
  author: "Farrell, G.",
  year: "2026",
  title: "NTO Registry: A Catalogue of Non-Traditional Outputs in the Life Sciences",
  version: stats.catalogueVersion,
  url: "https://nto-registry.org",
  repo: "https://github.com/BioComputingUP/nto-registry",
  license: "CC BY 4.0",
};

const registryReference = `${registry.author} (${registry.year}). ${registry.title} (Version ${registry.version}) [Data set]. ${registry.url}`;

const registryBibtex = `@misc{farrell2026ntoregistry,
  author = {Farrell, Gavin},
  title = {{NTO Registry: A Catalogue of
    Non-Traditional Outputs in the Life Sciences}},
  year = {2026},
  version = {${registry.version}},
  url = {https://nto-registry.org},
  note = {Versioned catalogue, CC BY 4.0}
}`;
---

<BaseLayout title="About" description="The paper, authors, and ELIXIR Europe community behind the NTO Registry.">
  <section class="section page-header-section">
    <div class="container">
      <div class="about-title-row">
        <div>
          <p class="eyebrow">About</p>
          <h1>The paper behind this work</h1>
          <p class="section-intro about-lede" style="margin-left:0;">
            This registry operationalises the landscaping presented in a preprint from members
            of the ELIXIR Europe community.
          </p>
        </div>
        <div class="about-hero-badge" aria-hidden="true">
          <svg viewBox="0 0 260 240" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <circle cx="196" cy="56" r="52" fill="var(--color-teal-500)" opacity="0.14" />
            <circle cx="44" cy="184" r="40" fill="var(--color-accent)" opacity="0.12" />
            <circle cx="232" cy="192" r="20" fill="var(--color-teal-500)" opacity="0.18" />
            <circle cx="18" cy="26" r="16" fill="var(--color-navy-700)" opacity="0.1" />

            <g transform="translate(34,24)">
              <rect width="192" height="192" rx="30" fill="var(--color-surface)" stroke="var(--color-border)" />
              <g transform="translate(48,48) scale(4)" stroke="var(--color-accent)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 6c-2-1.3-5-1.7-8-1v13c3-.7 6-.3 8 1 2-1.3 5-1.7 8-1V5c-3-.7-6-.3-8 1Zm0 0v13" />
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section preprint-section">
    <div class="container">
      <p class="eyebrow">Preprint</p>
      <h2>Credit, recognition, and reward for non-traditional research outputs<br />in the Life Sciences</h2>
      <div class="preprint-layout">
        <p>
          Publication metrics remain the primary academic performance assessment in modern
          academia, leaving a gap in recognition for impactful non-traditional
          outputs such as curated datasets, research software, and training materials.
          Through a mapping of valuable non-traditional outputs illustrated by Life Science
          examples from ELIXIR Europe, this paper examines the technical solutions and
          sociological barriers to credit, recognition, and reward — the landscaping this
          registry hosts as versioned, machine-readable data.
        </p>
        <div class="preprint-cta-col">
          <div class="preprint-cta-badge" aria-hidden="true">
            <img src={`${base}img/logos/metaarxiv.png`} alt="" width="120" height="117" loading="lazy" />
          </div>
          <a class="btn btn-primary preprint-cta" href="https://osf.io/preprints/metaarxiv/praxg_v1" target="_blank" rel="noopener">
            <span class="btn-icon" set:html={WHITE_ICONS.book} />
            Read the Preprint on OSF (MetaArXiv)
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container">
      <h2 class="section-heading authors-heading" style="text-align:center;">Authors</h2>
      <div class="grid grid-4">
        {authors.map((author) => (
          <div class="card author-card author-card-aligned">
            {author.photo ? (
              <img class="author-photo" src={`${base}${author.photo}`} alt={author.name} loading="lazy" />
            ) : (
              <div class="author-initials" aria-hidden="true">{initials(author.name)}</div>
            )}
            <h4 class="author-name">{author.name}</h4>
            {author.role && <p class="author-role">{author.role}</p>}
            <p class:list={["author-affiliation", !author.role && "author-affiliation-float"]}>{author.affiliation}</p>
            {author.orcid && (
              <a href={`https://orcid.org/${author.orcid}`} target="_blank" rel="noopener" class="orcid-link" aria-label={`${author.name}'s ORCID iD`} title="View ORCID iD">
                <img src="https://orcid.org/assets/vectors/orcid.logo.icon.svg" alt="" width="20" height="20" loading="lazy" />
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cite-section" id="cite">
    <div class="container">
      <p class="eyebrow">Citation</p>
      <h2>Cite the NTO Registry</h2>
      <p class="cite-lede">
        There are two citable things here, and they do different jobs. Cite the <strong>preprint</strong> for the landscaping, the argument, and the artefact taxonomy. Cite the <strong>registry</strong> when you use, quote, or build on the catalogue data itself — it is versioned, so pin the version you used. If you do both, cite both.
      </p>

      <div class="grid grid-2 cite-grid">
        <div class="card cite-card">
          <div class="cite-card-head">
            <span class="cite-card-icon" set:html={ICONS.quote} />
            <div>
              <h3>The preprint</h3>
              <p class="cite-card-sub">Preferred citation for the work</p>
            </div>
          </div>

          <blockquote class="cite-reference" id="cite-ref-preprint">{preprintReference}</blockquote>
          <button class="cite-copy" type="button" data-copy-target="cite-ref-preprint" data-copy-label="Copy reference">
            <span class="cite-copy-icon" set:html={ICONS.document} />
            <span class="cite-copy-text" aria-live="polite">Copy reference</span>
          </button>

          <dl class="cite-meta">
            <div class="cite-meta-row">
              <dt>DOI</dt>
              <dd><a href={preprint.doiUrl} target="_blank" rel="noopener">{preprint.doi}</a></dd>
            </div>
            <div class="cite-meta-row">
              <dt>Posted</dt>
              <dd>{preprint.posted} ({preprint.version})</dd>
            </div>
            <div class="cite-meta-row">
              <dt>Server</dt>
              <dd>{preprint.server} — {preprint.publisher}</dd>
            </div>
            <div class="cite-meta-row">
              <dt>Licence</dt>
              <dd>{preprint.license}</dd>
            </div>
          </dl>

          <details class="cite-bibtex">
            <summary>BibTeX</summary>
            <pre><code id="cite-bib-preprint">{preprintBibtex}</code></pre>
            <button class="cite-copy" type="button" data-copy-target="cite-bib-preprint" data-copy-label="Copy BibTeX">
              <span class="cite-copy-icon" set:html={ICONS.code} />
              <span class="cite-copy-text" aria-live="polite">Copy BibTeX</span>
            </button>
          </details>

          <p class="cite-note">
            Title, byline, and date above are the record as posted in version 1. A revised version with an expanded author list is in preparation and will be cross-linked here once posted.
          </p>

          <a class="cite-link" href={preprint.osfUrl} target="_blank" rel="noopener">
            <span class="cite-link-icon" set:html={ICONS["external-link"]} />Read the preprint on OSF
          </a>
        </div>

        <div class="card cite-card">
          <div class="cite-card-head">
            <span class="cite-card-icon" set:html={ICONS.database} />
            <div>
              <h3>The registry</h3>
              <p class="cite-card-sub">The versioned catalogue itself</p>
            </div>
          </div>

          <blockquote class="cite-reference" id="cite-ref-registry">{registryReference}</blockquote>
          <button class="cite-copy" type="button" data-copy-target="cite-ref-registry" data-copy-label="Copy reference">
            <span class="cite-copy-icon" set:html={ICONS.document} />
            <span class="cite-copy-text" aria-live="polite">Copy reference</span>
          </button>

          <dl class="cite-meta">
            <div class="cite-meta-row">
              <dt>Version</dt>
              <dd>{registry.version} <span class="cite-meta-hint">— cite the version you used</span></dd>
            </div>
            <div class="cite-meta-row">
              <dt>Site</dt>
              <dd><a href={registry.url}>nto-registry.org</a></dd>
            </div>
            <div class="cite-meta-row">
              <dt>Code &amp; data</dt>
              <dd><a href={registry.repo} target="_blank" rel="noopener">BioComputingUP/nto-registry</a></dd>
            </div>
            <div class="cite-meta-row">
              <dt>Licence</dt>
              <dd>{registry.license}</dd>
            </div>
          </dl>

          <details class="cite-bibtex">
            <summary>BibTeX</summary>
            <pre><code id="cite-bib-registry">{registryBibtex}</code></pre>
            <button class="cite-copy" type="button" data-copy-target="cite-bib-registry" data-copy-label="Copy BibTeX">
              <span class="cite-copy-icon" set:html={ICONS.code} />
              <span class="cite-copy-text" aria-live="polite">Copy BibTeX</span>
            </button>
          </details>

          <p class="cite-note">
            Machine-readable metadata for this citation lives in <code>CITATION.cff</code> in the repository, which GitHub and most reference managers can import directly.
          </p>

          <a class="cite-link" href={`${registry.repo}/blob/main/CITATION.cff`} target="_blank" rel="noopener">
            <span class="cite-link-icon" set:html={ICONS["external-link"]} />View CITATION.cff
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div class="card contact-card">
          <div class="contact-card-head">
            <span class="contact-card-icon" set:html={ICONS.users} />
            <h3>ELIXIR CRU Focus Group</h3>
          </div>
          <p>
            This work is carried out in collaboration with the ELIXIR Europe Credit,
            Recognition & Usage Focus Group, which brings together the wider community
            working on these challenges.
          </p>
          <a class="btn btn-outline" href="https://elixir-europe.org/focus-groups/credit-recognition-usage" target="_blank" rel="noopener">
            Visit the focus group
          </a>
        </div>
        <div class="card contact-card">
          <div class="contact-card-head">
            <span class="contact-card-icon" set:html={GITHUB_ICON} />
            <h3>The Registry on GitHub</h3>
          </div>
          <p>
            The data behind this site — the output catalogue, infrastructure catalogue,
            and reform initiatives — is versioned and openly maintained on GitHub.
            Contributions are welcome.
          </p>
          <a class="btn btn-outline" href="https://github.com/BioComputingUP/nto-registry" target="_blank" rel="noopener">
            View the repository
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .about-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .about-hero-badge {
      flex-shrink: 0;
      width: 190px;
    }

    .about-hero-badge svg {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 820px) {
      .about-hero-badge {
        display: none;
      }
    }

    .about-lede {
      max-width: none;
    }

    @media (min-width: 700px) {
      .about-lede {
        white-space: nowrap;
      }
    }

    .preprint-section h2 {
      max-width: none;
    }

    .preprint-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: var(--space-7);
      align-items: end;
      margin-top: var(--space-2);
    }

    .preprint-layout p {
      max-width: 620px;
      margin-bottom: 0;
    }

    .preprint-cta-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
    }

    .preprint-cta-badge {
      width: 108px;
    }

    .preprint-cta-badge img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 50%;
      box-shadow: var(--shadow-sm);
    }

    .preprint-cta {
      white-space: nowrap;
    }

    @media (max-width: 780px) {
      .preprint-layout {
        grid-template-columns: 1fr;
      }

      .preprint-cta-col {
        align-items: flex-start;
      }

      .preprint-cta-badge {
        display: none;
      }
    }

    .btn-icon {
      display: inline-flex;
    }

    .btn-icon :global(svg) {
      width: 18px;
      height: 18px;
    }

    .authors-heading {
      margin-bottom: var(--space-6);
    }

    .contact-card-head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .contact-card-head h3 {
      margin: 0;
    }

    .contact-card-icon {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--color-accent);
    }

    .contact-card-icon :global(svg) {
      width: 28px;
      height: 28px;
    }

    .author-card-aligned {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* For authors with no role line, float the affiliation text midway in
       the leftover space between the name and the ORCID icon at the
       bottom, instead of it sitting flush under the name with all the
       dead space pushed below it. Authors with a role keep the tighter
       name/role/affiliation stack (unchanged) since that already reads
       fine as a compact block. */
    .author-affiliation-float {
      margin-top: auto;
      margin-bottom: auto;
    }

    .orcid-link {
      display: inline-flex;
      margin-top: auto;
      padding-top: var(--space-2);
    }

    .orcid-link img {
      opacity: 0.85;
      transition: opacity 0.15s ease;
    }

    .orcid-link:hover img {
      opacity: 1;
    }
    .cite-lede {
      max-width: 780px;
      color: var(--color-text-muted);
      margin-bottom: var(--space-6);
    }

    .cite-card {
      display: flex;
      flex-direction: column;
    }

    .cite-card-head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
    }

    .cite-card-head h3 {
      margin: 0;
    }

    .cite-card-icon {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--color-accent);
    }

    .cite-card-icon :global(svg) {
      width: 28px;
      height: 28px;
    }

    .cite-card-sub {
      margin: 0;
      font-size: var(--fs-small);
      color: var(--color-text-muted);
    }

    /* The reference itself is the thing most visitors came for, so it gets
       the accent rule and a tighter, quotable block rather than sitting as
       ordinary body copy. */
    .cite-reference {
      margin: 0 0 var(--space-3);
      padding: var(--space-4);
      border-left: 3px solid var(--color-accent);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      background: var(--color-bg-subtle);
      font-size: var(--fs-small);
      line-height: 1.65;
    }

    .cite-copy {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.4rem 0.85rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      color: var(--color-text-muted);
      font-family: inherit;
      font-size: var(--fs-small);
      font-weight: 600;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .cite-copy:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
    }

    .cite-copy[data-copied="true"] {
      color: var(--color-badge-active-text);
      border-color: var(--color-badge-active-text);
    }

    .cite-copy-icon {
      display: inline-flex;
    }

    .cite-copy-icon :global(svg) {
      width: 16px;
      height: 16px;
    }

    .cite-meta {
      margin: var(--space-5) 0 0;
      display: grid;
      gap: var(--space-2);
      font-size: var(--fs-small);
    }

    .cite-meta-row {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .cite-meta dt {
      color: var(--color-text-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 0.78rem;
      padding-top: 0.1rem;
    }

    .cite-meta dd {
      margin: 0;
      overflow-wrap: anywhere;
    }

    .cite-meta-hint {
      color: var(--color-text-muted);
    }

    .cite-bibtex {
      margin-top: var(--space-5);
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-4);
    }

    .cite-bibtex summary {
      cursor: pointer;
      font-weight: 700;
      font-size: var(--fs-small);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .cite-bibtex summary:hover {
      color: var(--color-accent);
    }

    .cite-bibtex pre {
      margin: var(--space-3) 0;
      padding: var(--space-4);
      background: var(--color-bg-subtle);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      overflow-x: auto;
    }

    .cite-bibtex code,
    .cite-note code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.82rem;
      line-height: 1.55;
    }

    .cite-note {
      margin: var(--space-5) 0 var(--space-4);
      font-size: var(--fs-small);
      color: var(--color-text-muted);
    }

    /* Pins the "read it / view it" link to the bottom of both cards so the
       two line up even when the metadata lists differ in height. */
    .cite-link {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-weight: 600;
      font-size: var(--fs-small);
      color: var(--color-accent);
    }

    .cite-link-icon {
      display: inline-flex;
    }

    .cite-link-icon :global(svg) {
      width: 16px;
      height: 16px;
    }

    @media (max-width: 520px) {
      .cite-meta-row {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }

  </style>

  <script>
    // Copy-to-clipboard for the citation blocks. Each button names the element
    // holding the text via data-copy-target; the label swaps for a moment and
    // data-copied drives the button's success colour.
    document.querySelectorAll(".cite-copy").forEach((button) => {
      const label = button.querySelector(".cite-copy-text");
      const target = document.getElementById(button.dataset.copyTarget || "");
      if (!label || !target) return;

      const reset = () => {
        label.textContent = button.dataset.copyLabel || "Copy";
        delete button.dataset.copied;
      };

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText((target.textContent || "").trim());
          label.textContent = "Copied";
          button.dataset.copied = "true";
        } catch {
          // Clipboard access can be refused (insecure context, or the user's
          // browser permissions) — say so rather than claiming success.
          label.textContent = "Copy failed — select the text";
        }
        window.setTimeout(reset, 2500);
      });
    });
  </script>
</BaseLayout>
