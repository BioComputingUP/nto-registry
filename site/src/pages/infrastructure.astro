---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ICONS, GITHUB_ICON } from "../lib/icons";
import infrastructure from "../generated/infrastructure-catalogue.json";

const base = import.meta.env.BASE_URL;

const PRIMARY_IDS = new Set(["apicuron", "orcid", "bip-scholar"]);

// Not shown on this page for now (still valid data — e.g. referenced by
// the FAIR Software Release artefact — just not listed here).
const HIDDEN_IDS = new Set(["openebench"]);

type LogoEntry =
  | { type: "img"; src: string; scale?: number }
  | { type: "svg"; markup: string }
  | { type: "icon"; key: string; color: string };

// Real logos, fetched from each platform's own official asset: ORCID's
// hosted icon, the GitHub mark already used elsewhere on the site,
// Zenodo's official logo (Wikimedia Commons, sourced from their own
// Wikipedia article), ELIXIR TeSS's dedicated service logo (from the
// ELIXIR UK Node's own site, not just the generic ELIXIR org mark),
// dedicated GitHub-org logos for FAIRsharing/OpenAIRE Graph/bio.tools/
// WorkflowHub/BIP! where that was a cleaner result than their favicon.
// FAIRsharing's own hosted SVG (fairsharing.org/assets/fairsharing-logo.svg)
// could not be fetched directly from this environment (network-blocked),
// so its GitHub org avatar is used instead — also their real logo, just a
// different official asset than the one specified.
const LOGOS: Record<string, LogoEntry> = {
  apicuron: { type: "img", src: `${base}img/logos/apicuron.png` },
  orcid: { type: "img", src: "https://orcid.org/assets/vectors/orcid.logo.icon.svg" },
  "bio-tools": { type: "img", src: `${base}img/logos/bio-tools.png` },
  workflowhub: { type: "img", src: `${base}img/logos/workflowhub.png` },
  "elixir-tess": { type: "img", src: `${base}img/logos/elixir-tess.png` },
  zenodo: { type: "img", src: `${base}img/logos/zenodo.svg`, scale: 1.3 },
  github: { type: "svg", markup: GITHUB_ICON },
  "openaire-graph": { type: "img", src: `${base}img/logos/openaire-graph.png` },
  "bip-finder": { type: "img", src: `${base}img/logos/bip.png` },
  "bip-scholar": { type: "img", src: `${base}img/logos/bip.png` },
  fairsharing: { type: "img", src: `${base}img/logos/fairsharing.png` },
};

// Which NTRA category each registration service is most associated with
// (shown as a colour tag on its card, reusing the Registry page's category
// colours). Services that register/enrich artefacts broadly, not tied to
// one category, get "General" instead of being forced into one.
const REGISTRATION_CATEGORY: Record<string, string> = {
  "bio-tools": "Software",
  workflowhub: "Software",
  "elixir-tess": "Training",
  zenodo: "General",
  github: "Software",
  "openaire-graph": "General",
  "bip-finder": "General",
  fairsharing: "Data",
};

const CATEGORY_COLOR_VAR: Record<string, string> = {
  Data: "--cat-data",
  Training: "--cat-training",
  Software: "--cat-software",
  "Research support": "--cat-research-support",
  "Peer review": "--cat-peer-review",
  General: "--cat-generic",
};

const LOGO_BASE_SIZE = 72;

const primary = infrastructure
  .filter((i) => PRIMARY_IDS.has(i.id))
  .sort((a, b) => a.name.localeCompare(b.name));
const registration = infrastructure
  .filter((i) => !PRIMARY_IDS.has(i.id) && !HIDDEN_IDS.has(i.id))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Infrastructure" description="Technical infrastructure capable of capturing credit for Non-Traditional Research Artefacts.">
  <section class="section page-header-section">
    <div class="container">
      <div class="infra-title-row">
        <div>
          <p class="eyebrow">Credit-capture infrastructure</p>
          <h1>Non-Traditional Research Artefact Infrastructure</h1>
        </div>
        <div class="infra-hero-badge" aria-hidden="true">
          <svg viewBox="0 0 260 240" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <circle cx="196" cy="56" r="52" fill="var(--color-teal-500)" opacity="0.14" />
            <circle cx="44" cy="184" r="40" fill="var(--color-accent)" opacity="0.12" />
            <circle cx="232" cy="192" r="20" fill="var(--color-teal-500)" opacity="0.18" />
            <circle cx="18" cy="26" r="16" fill="var(--color-navy-700)" opacity="0.1" />

            <g transform="translate(34,24)">
              <rect width="192" height="192" rx="30" fill="var(--color-surface)" stroke="var(--color-border)" />
              <g transform="translate(48,48) scale(4)" stroke="var(--color-teal-500)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2.5" />
                <rect x="9" y="9" width="6" height="6" rx="1" />
                <path d="M9 4v2M15 4v2M9 18v2M15 18v2M4 9h2M4 15h2M18 9h2M18 15h2" />
              </g>
            </g>
          </svg>
        </div>
      </div>
      <p class="section-intro" style="margin-left:0;">
        The platforms that turn artefact-level effort into machine-readable, citable credit —
        from persistent identifiers to granular contribution tracking to aggregated researcher
        profiles.
      </p>
    </div>
  </section>

  <section class="section infra-primary-section">
    <div class="container">
      <p class="eyebrow">Primary credit-capture infrastructure</p>
      <h2 class="section-heading-left">Primary Credit-Capture Infrastructure</h2>
      <p class="section-intro-left">
        The three platforms with the broadest general-purpose functionality for crediting
        non-traditional research artefacts and the activity behind them — the artefact itself,
        rather than just the activity, is the primary focus.
      </p>
      <div class="grid grid-3">
        {primary.map((infra) => {
          const logo = LOGOS[infra.id];
          return (
            <article class="card infra-card infra-card-primary">
              <div class="infra-logo-wrap">
                {logo.type === "img" && <img class="infra-logo" src={logo.src} alt="" loading="lazy" />}
                {logo.type === "svg" && <span class="infra-logo-icon" set:html={logo.markup} />}
                {logo.type === "icon" && (
                  <span class="infra-logo-icon" style={`color:${logo.color}`} set:html={ICONS[logo.key]} />
                )}
              </div>
              <h3><a href={infra.url} target="_blank" rel="noopener">{infra.name}</a></h3>
              <p>{infra.function}</p>
              <details class="infra-details">
                <summary class="btn btn-outline registry-toggle">Show details</summary>
                <div class="registry-card-details">
                  <h4>Currently captures credit for</h4>
                  {infra.activeFor.length > 0 ? (
                    <ul class="infra-focus-list">
                      {infra.activeFor.map((ref) => (
                        <li><strong>{ref.artefact}</strong> ({ref.category})</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="infra-focus-empty">No active mappings yet.</p>
                  )}
                </div>
              </details>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-subtle infra-registration-section">
    <div class="container">
      <p class="eyebrow">Registration &amp; discovery</p>
      <h2 class="section-heading-left">Registration Services for Non-Traditional Research Artefacts</h2>
      <p class="section-intro-left">
        Platforms that give an artefact itself a live, registered digital presence — a
        discoverable record with a persistent identifier — which can then feed into the
        credit-capture platforms above. Registering software in bio.tools, for example, gives
        it a persistent identifier that ORCID or APICURON records can point back to; registering
        a database in FAIRsharing does the same for data. DOI-issuing registries such as Zenodo
        offer an even stronger guarantee of long-term permanence.
      </p>
      <div class="grid grid-3">
        {registration.map((infra) => {
          const logo = LOGOS[infra.id];
          const tagCategory = REGISTRATION_CATEGORY[infra.id] ?? "General";
          const tagColor = `var(${CATEGORY_COLOR_VAR[tagCategory]})`;
          const logoSize = logo.type === "img" && logo.scale ? Math.round(LOGO_BASE_SIZE * logo.scale) : LOGO_BASE_SIZE;
          return (
            <article class="card infra-card" style={`border-color:${tagColor}`}>
              <div class="infra-logo-wrap" style={`width:${logoSize}px;height:${logoSize}px`}>
                {logo.type === "img" && <img class="infra-logo" src={logo.src} alt="" loading="lazy" />}
                {logo.type === "svg" && <span class="infra-logo-icon" set:html={logo.markup} />}
                {logo.type === "icon" && (
                  <span class="infra-logo-icon" style={`color:${logo.color}`} set:html={ICONS[logo.key]} />
                )}
              </div>
              <h3><a href={infra.url} target="_blank" rel="noopener">{infra.name}</a></h3>
              <p>{infra.function}</p>
              <div class="infra-card-footer">
                <span class="badge badge-category infra-category-tag" style={`background:${tagColor}`}>{tagCategory}</span>
                <details class="infra-details">
                  <summary class="btn btn-outline registry-toggle">Show details</summary>
                  <div class="registry-card-details">
                    <h4>Currently captures credit for</h4>
                    {infra.activeFor.length > 0 ? (
                      <ul class="infra-focus-list">
                        {infra.activeFor.map((ref) => (
                          <li><strong>{ref.artefact}</strong> ({ref.category})</li>
                        ))}
                      </ul>
                    ) : (
                      <p class="infra-focus-empty">No active mappings yet.</p>
                    )}
                  </div>
                </details>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <h2>Know of infrastructure that should be here?</h2>
      <p>
        Propose a platform that captures credit for a non-traditional research artefact type.
      </p>
      <a class="btn btn-primary" href="https://github.com/gavinf97/ntra-registry/issues/new?template=submit_ntra_example.yml" target="_blank" rel="noopener">
        Submit new infrastructure
      </a>
    </div>
  </section>

  <style>
    .infra-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .infra-hero-badge {
      flex-shrink: 0;
      width: 190px;
    }

    .infra-hero-badge svg {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 820px) {
      .infra-hero-badge {
        display: none;
      }
    }

    .infra-primary-section {
      padding-top: var(--space-6);
    }

    .section-heading-left {
      margin-bottom: var(--space-2);
    }

    .section-intro-left {
      color: var(--color-text-muted);
      font-size: 1.1rem;
      max-width: 760px;
      margin-bottom: var(--space-7);
    }

    .grid-3 {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .infra-card {
      border-width: 2px;
    }

    .infra-card-primary {
      border-color: var(--color-accent);
    }

    .infra-logo-wrap {
      width: 72px;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      margin-bottom: var(--space-3);
    }

    .infra-logo {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: var(--radius-sm);
    }

    .infra-logo-icon {
      display: inline-flex;
    }

    .infra-logo-icon :global(svg) {
      width: 52px;
      height: 52px;
    }

    .infra-card h3 {
      margin-bottom: var(--space-2);
    }

    .infra-category-tag {
      align-self: flex-start;
    }

    /* Registration cards wrap the tag + details toggle together so both
       stay glued to each other and pinned to the card's bottom as a unit,
       regardless of how long the function description above them is —
       keeps the tag at a fixed position immediately above "Show details"
       on every card instead of drifting with paragraph length. */
    .infra-card-footer {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .infra-card-footer .infra-details {
      margin-top: 0;
      padding-top: 0;
    }

    .infra-details {
      margin-top: auto;
      padding-top: var(--space-3);
    }

    .infra-details summary {
      list-style: none;
      cursor: pointer;
    }

    .infra-details summary::-webkit-details-marker {
      display: none;
    }

    .infra-details summary::marker {
      content: "";
    }

    .infra-details[open] summary {
      margin-bottom: var(--space-3);
    }

    .cta-section {
      text-align: center;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .cta-inner {
      max-width: 600px;
      margin: 0 auto;
    }
  </style>
</BaseLayout>
