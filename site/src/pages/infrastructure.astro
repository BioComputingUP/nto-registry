---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ICONS, GITHUB_ICON } from "../lib/icons";
import infrastructure from "../generated/infrastructure-catalogue.json";

const base = import.meta.env.BASE_URL;

type LogoEntry =
  | { type: "img"; src: string; scale?: number; width?: number }
  | { type: "svg"; markup: string }
  | { type: "icon"; key: string; color: string };

// Real logos, fetched from each platform's own official asset: ORCID's
// hosted icon, the GitHub mark already used elsewhere on the site,
// Zenodo's official logo (Wikimedia Commons, sourced from their own
// Wikipedia article), ELIXIR TeSS's dedicated service logo (from the
// ELIXIR UK Node's own site, not just the generic ELIXIR org mark),
// dedicated GitHub-org logos for FAIRsharing/OpenAIRE Graph/bio.tools/
// WorkflowHub/BIP! where that was a cleaner result than their favicon.
// FAIRsharing's own hosted SVG (fairsharing.org/assets/fairsharing-logo.svg)
// could not be fetched directly from this environment (network-blocked),
// so its GitHub org avatar is used instead — also their real logo, just a
// different official asset than the one specified.
//
// Software Heritage, DMPonline, and CRediT logos were pulled directly from
// each platform's own site (softwareheritage.org, dmponline.dcc.ac.uk,
// credit.niso.org). DMPonline's hosted asset is a white-on-transparent
// wordmark (meant for a dark header bar); it's recoloured here to
// DMPonline's own brand orange (`#f49700`, taken from their site's own
// stylesheet) so it stays legible on a light card background too — same
// artwork, just a colour already used in their brand rather than an
// invisible white-on-white render. It's also a wide wordmark (not square),
// so it gets an explicit wider box via `width` — but height always stays
// the same as every other logo, so card titles still line up across a row.
// ELIXIR EDD doesn't have its own separate visual identity
// (its dedicated "service collection" badge is only distributed internally
// to member services per ELIXIR's brand guidelines, not published as a
// standalone web asset), so it uses ELIXIR's own real org logomark, fetched
// directly from elixir-europe.org's own asset host.
// OpenEBench's logo is its own app icon, pulled from its own site
// (openebench.bsc.es) — it and OpenAIRE Graph/BIP! were previously hidden
// from this page entirely and never needed a logo; now shown per Table 2.
// PREreview's icon mark is cropped (via viewBox) from its own hosted SVG
// (prereview.org), which cleanly separates the icon from the wordmark in
// its own <g id="mark"> group — a real, small, already-optimised asset,
// unlike the wordmark logos elsewhere on this page that needed rasterising.
const LOGOS: Record<string, LogoEntry> = {
  apicuron: { type: "img", src: `${base}img/logos/apicuron.png` },
  orcid: { type: "img", src: "https://orcid.org/assets/vectors/orcid.logo.icon.svg" },
  "bio-tools": { type: "img", src: `${base}img/logos/bio-tools.png` },
  workflowhub: { type: "img", src: `${base}img/logos/workflowhub.png` },
  "elixir-tess": { type: "img", src: `${base}img/logos/elixir-tess.png` },
  zenodo: { type: "img", src: `${base}img/logos/zenodo.svg`, scale: 1.3 },
  github: { type: "svg", markup: GITHUB_ICON },
  "openaire-graph": { type: "img", src: `${base}img/logos/openaire-graph.png` },
  "bip-finder": { type: "img", src: `${base}img/logos/bip.png` },
  "bip-scholar": { type: "img", src: `${base}img/logos/bip.png` },
  fairsharing: { type: "img", src: `${base}img/logos/fairsharing.png` },
  openebench: { type: "img", src: `${base}img/logos/openebench.png` },
  "elixir-edd": { type: "img", src: `${base}img/logos/elixir-edd.png` },
  dmponline: { type: "img", src: `${base}img/logos/dmponline.png`, width: 168 },
  "software-heritage": { type: "img", src: `${base}img/logos/software-heritage.png` },
  "credit-taxonomy": { type: "img", src: `${base}img/logos/credit.png` },
  prereview: { type: "img", src: `${base}img/logos/prereview.svg` },
};

// Which NTO category each platform is most associated with (shown as a
// colour tag on its card, reusing the Registry page's category colours).
// Sourced from Table 2 of the paper where it names a category directly
// (e.g. "bio.tools (Software & tools)"); platforms whose active mappings
// span multiple categories, or that register/enrich broadly rather than
// serving one category, get "General" instead of being forced into one.
const NTO_CATEGORY: Record<string, string> = {
  fairsharing: "Data",
  "elixir-edd": "Data",
  dmponline: "Data",
  "bio-tools": "Software",
  workflowhub: "Software",
  github: "Software",
  "software-heritage": "Software",
  openebench: "Software",
  "elixir-tess": "Training",
  prereview: "Peer review",
  orcid: "General",
  "bip-scholar": "General",
  "bip-finder": "General",
  "openaire-graph": "General",
  apicuron: "General",
  "credit-taxonomy": "General",
  zenodo: "General",
};

const CATEGORY_COLOR_VAR: Record<string, string> = {
  Data: "--cat-data",
  Training: "--cat-training",
  Software: "--cat-software",
  "Research support": "--cat-research-support",
  "Peer review": "--cat-peer-review",
  General: "--cat-generic",
};

// Table 2's six technical-component rows, keyed by the leading phrase of
// each platform's `function` field in infrastructure_catalogue.yml (e.g.
// "Publishing & PID provision. Specialised registry assigning..." -> keyed
// on "Publishing & PID provision"). Order here fixes both the tier grouping
// (essential vs intermediary) and the on-page section order.
type FunctionKey =
  | "Publishing & PID provision"
  | "Academic profiles"
  | "Aggregation"
  | "Metadata enrichment"
  | "Contribution tracking & incentives"
  | "Ontologies & controlled vocabularies";

const FUNCTION_META: Record<FunctionKey, { tier: "essential" | "intermediary"; anchor: string; title: string; blurb: string }> = {
  "Publishing & PID provision": {
    tier: "essential",
    anchor: "publishing-pid",
    title: "Publishing & Persistent Identifier Provision",
    blurb:
      "These platforms provide the initial repository registration for NTOs and assign the unique persistent identifiers (PIDs) necessary for their discovery, metadata hosting, and subsequent citation.",
  },
  "Academic profiles": {
    tier: "essential",
    anchor: "academic-profiles",
    title: "Academic Profiles & Representation",
    blurb:
      "These systems aggregate data from primary NTO repositories, enriched metadata services, and active tracking platforms to comprehensively host and represent PID-associated NTOs — translating granular research activity into meaningful, human-readable profiles suitable for formal academic assessment.",
  },
  Aggregation: {
    tier: "intermediary",
    anchor: "aggregation",
    title: "Aggregation & Deduplication",
    blurb:
      "Aggregation services merge PID-assigned NTO metadata from diverse repositories into a unified, searchable knowledge graph — essential for deduplicating records to prevent double-counting across platforms, so that clean, verified data feeds into academic profiling systems.",
  },
  "Metadata enrichment": {
    tier: "intermediary",
    anchor: "metadata-enrichment",
    title: "Metadata Enrichment & Quality Context",
    blurb:
      "These services enrich basic NTO metadata by appending missing annotations, such as specific topics or technical performance indicators — contextual enrichment that is crucial for establishing the qualitative value of NTOs and helping to prevent a quantity-over-quality assessment model.",
  },
  "Contribution tracking & incentives": {
    tier: "intermediary",
    anchor: "contribution-tracking",
    title: "Active Contribution Tracking",
    blurb:
      "Active tracking platforms capture granular NTO contributions at scale through dynamic recognition models — essential for recording vital, ongoing research labour (e.g. curation) that holds significant aggregate value but remains entirely invisible within publications.",
  },
  "Ontologies & controlled vocabularies": {
    tier: "intermediary",
    anchor: "ontologies",
    title: "Ontologies & Controlled Vocabularies",
    blurb:
      "Structured ontologies and fixed vocabularies provide the essential semantic foundation for system interoperability, enabling highly granular, machine-readable specifications so data flows cohesively between credit-capture platforms. A major gap remains, however: dedicated NTO ontologies barely exist yet.",
  },
};

// Presentation metadata for the pipeline diagram in the page header: which
// ICONS glyph stands for each of the six components, and a shortened label
// for the diagram's chips (FUNCTION_META's full titles are section headings
// and are too long to sit in a chip). Keyed by FunctionKey, so it can't
// address a component that doesn't exist, and `short` falls back to the real
// title — there is still exactly one source of truth for the names.
const PIPELINE_META: Record<FunctionKey, { icon: string; short?: string }> = {
  "Publishing & PID provision": { icon: "link", short: "Publishing & PID Provision" },
  "Academic profiles": { icon: "users", short: "Academic Profiles" },
  Aggregation: { icon: "database", short: "Aggregation" },
  "Metadata enrichment": { icon: "star", short: "Metadata Enrichment" },
  "Contribution tracking & incentives": { icon: "trending-up", short: "Contribution Tracking" },
  "Ontologies & controlled vocabularies": { icon: "book", short: "Ontologies & Vocabularies" },
};

const LOGO_BASE_SIZE = 72;

// Every logo box is the same height, so card titles/text line up across a
// row regardless of which card's logo happens to render next to it. A few
// logos (e.g. DMPonline's wide wordmark) declare an explicit `width` to get
// more room than a square box would give them — forcing a wide, short logo
// into a square box shrinks it down to a sliver — but height never varies.
function logoBoxStyle(logo: LogoEntry): string {
  const height = logo.type === "img" && logo.scale ? Math.round(LOGO_BASE_SIZE * logo.scale) : LOGO_BASE_SIZE;
  const width = logo.type === "img" && logo.width ? logo.width : height;
  return `width:${width}px;height:${height}px`;
}

function functionKeyOf(fn: string): FunctionKey {
  return fn.split(".")[0].trim() as FunctionKey;
}

const bySection = new Map<FunctionKey, typeof infrastructure>();
for (const infra of infrastructure) {
  const key = functionKeyOf(infra.function);
  if (!bySection.has(key)) bySection.set(key, []);
  bySection.get(key)!.push(infra);
}
for (const list of bySection.values()) {
  list.sort((a, b) => a.name.localeCompare(b.name));
}

const sectionOrder = Object.keys(FUNCTION_META) as FunctionKey[];
const essentialSections = sectionOrder.filter((k) => FUNCTION_META[k].tier === "essential");
const intermediarySections = sectionOrder.filter((k) => FUNCTION_META[k].tier === "intermediary");

// The pipeline diagram's arrangement: the two essential components bookend
// the flow, three intermediary components form the sequential chain between
// them, and Ontologies sits underneath that chain as a substrate rather than
// as a fourth step — it's what the other three stand on, not a stage they
// pass through. Only the *arrangement* lives here; every label, anchor and
// tier colour is read from FUNCTION_META.
const PIPELINE = {
  left: "Publishing & PID provision",
  chain: ["Aggregation", "Metadata enrichment", "Contribution tracking & incentives"],
  substrate: "Ontologies & controlled vocabularies",
  right: "Academic profiles",
} as const satisfies { left: FunctionKey; chain: readonly FunctionKey[]; substrate: FunctionKey; right: FunctionKey };

// Adding a seventh function phrase to FUNCTION_META is explicitly allowed (see
// the add-nto-entry skill), and it would otherwise appear as a section below
// while silently missing from the diagram above. Fail the build instead, the
// same way a missing LOGOS entry already does.
const placedInPipeline: readonly FunctionKey[] = [PIPELINE.left, ...PIPELINE.chain, PIPELINE.substrate, PIPELINE.right];
const unplaced = sectionOrder.filter((key) => !placedInPipeline.includes(key));
if (unplaced.length) {
  throw new Error(`infrastructure.astro: pipeline diagram has no place for FUNCTION_META group(s): ${unplaced.join(", ")}`);
}

// The description text after the leading category phrase — that phrase is
// now conveyed by the section heading itself, so it's trimmed from the
// per-card copy to avoid repeating it on every card.
function cardDescription(fn: string): string {
  const parts = fn.split(".");
  return parts.slice(1).join(".").trim();
}
---

<BaseLayout title="Infrastructure" description="Technical infrastructure capable of capturing credit for Non-Traditional Outputs.">
  <section class="section page-header-section">
    <div class="container">
      <div class="infra-title-row">
        <div>
          <p class="eyebrow">Credit-capture infrastructure</p>
          <h1>Non-Traditional Output Infrastructure</h1>
          <p class="section-intro" style="margin-left:0;">
            The platforms that turn output-level effort into machine-readable, citable credit —
            from persistent identifiers to granular contribution tracking to aggregated researcher
            profiles.
          </p>
        </div>
        <div class="infra-hero-badge" aria-hidden="true">
          <svg viewBox="0 0 260 240" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <circle cx="196" cy="56" r="52" fill="var(--color-teal-500)" opacity="0.14" />
            <circle cx="44" cy="184" r="40" fill="var(--color-accent)" opacity="0.12" />
            <circle cx="232" cy="192" r="20" fill="var(--color-teal-500)" opacity="0.18" />
            <circle cx="18" cy="26" r="16" fill="var(--color-navy-700)" opacity="0.1" />

            <g transform="translate(34,24)">
              <rect width="192" height="192" rx="30" fill="var(--color-surface)" stroke="var(--color-border)" />
              <g transform="translate(48,48) scale(4)" stroke="var(--color-teal-500)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2.5" />
                <rect x="9" y="9" width="6" height="6" rx="1" />
                <path d="M9 4v2M15 4v2M9 18v2M15 18v2M4 9h2M4 15h2M18 9h2M18 15h2" />
              </g>
            </g>
          </svg>
        </div>
      </div>

    </div>
  </section>

  <section class="section infra-pipeline-section">
    <div class="container">
      <p class="eyebrow">How the layers fit together</p>
      <h2 class="section-heading-left">The credit-capture pipeline</h2>
      <p class="section-intro-left">
        Essential infrastructure sits at both ends: one platform gives an output its first
        persistent, citable identity, another surfaces that identity as part of a researcher's
        formal academic profile. Everything between them is intermediary — the services that
        merge, enrich, track and standardise the record on its way across.
      </p>

      <nav class="infra-pipeline" aria-label="Jump to an infrastructure layer">
        <a class="infra-pipeline-block" href={`#${FUNCTION_META[PIPELINE.left].anchor}`}>
          <span class="infra-pipeline-tier">Essential</span>
          <span class="infra-pipeline-icon" aria-hidden="true" set:html={ICONS[PIPELINE_META[PIPELINE.left].icon]} />
          <span class="infra-pipeline-name">{PIPELINE_META[PIPELINE.left].short ?? FUNCTION_META[PIPELINE.left].title}</span>
        </a>

        <span class="infra-pipeline-arrow" aria-hidden="true" set:html={ICONS["arrow-right"]} />

        <div class="infra-pipeline-middle">
          <span class="infra-pipeline-tier infra-pipeline-tier-intermediary">Intermediary</span>
          <div class="infra-pipeline-chain">
            {PIPELINE.chain.map((key, i) => (
              <Fragment>
                {i > 0 && <span class="infra-pipeline-arrow infra-pipeline-arrow-sm" aria-hidden="true" set:html={ICONS["arrow-right"]} />}
                <a class="infra-pipeline-chip" href={`#${FUNCTION_META[key].anchor}`}>
                  <span class="infra-pipeline-icon" aria-hidden="true" set:html={ICONS[PIPELINE_META[key].icon]} />
                  <span class="infra-pipeline-name">{PIPELINE_META[key].short ?? FUNCTION_META[key].title}</span>
                </a>
              </Fragment>
            ))}
          </div>
          <a class="infra-pipeline-substrate" href={`#${FUNCTION_META[PIPELINE.substrate].anchor}`}>
            <span class="infra-pipeline-icon" aria-hidden="true" set:html={ICONS[PIPELINE_META[PIPELINE.substrate].icon]} />
            <span class="infra-pipeline-name">{PIPELINE_META[PIPELINE.substrate].short ?? FUNCTION_META[PIPELINE.substrate].title}</span>
            <span class="infra-pipeline-substrate-note">Semantic substrate — underpins all three</span>
          </a>
        </div>

        <span class="infra-pipeline-arrow" aria-hidden="true" set:html={ICONS["arrow-right"]} />

        <a class="infra-pipeline-block" href={`#${FUNCTION_META[PIPELINE.right].anchor}`}>
          <span class="infra-pipeline-tier">Essential</span>
          <span class="infra-pipeline-icon" aria-hidden="true" set:html={ICONS[PIPELINE_META[PIPELINE.right].icon]} />
          <span class="infra-pipeline-name">{PIPELINE_META[PIPELINE.right].short ?? FUNCTION_META[PIPELINE.right].title}</span>
        </a>
      </nav>
    </div>
  </section>

  <section class="section infra-tier-section">
    <div class="container">
      <p class="eyebrow">Essential</p>
      <h2 class="section-heading-left">Essential Infrastructure</h2>
      <p class="section-intro-left">
        The baseline layer without which non-traditional outputs cannot be credited at all:
        platforms that give an output its first persistent, discoverable identity, and systems
        that surface that identity as part of a researcher's formal academic profile.
      </p>

      {essentialSections.map((key) => {
        const meta = FUNCTION_META[key];
        const items = bySection.get(key) ?? [];
        const isPublishing = key === "Publishing & PID provision";
        return (
          <div class="infra-subsection infra-subsection-essential" id={meta.anchor}>
            <h3 class="infra-subsection-title">{meta.title}</h3>
            <p class="infra-subsection-blurb">{meta.blurb}</p>
            <div class="grid grid-3">
              {items.map((infra) => {
                const logo = LOGOS[infra.id];
                const tagCategory = NTO_CATEGORY[infra.id] ?? "General";
                const tagColor = `var(${CATEGORY_COLOR_VAR[tagCategory]})`;
                return (
                  <article class="card infra-card" id={infra.id} style={`border-color:${tagColor}`}>
                    <span class="badge badge-category infra-category-tag" style={`background:${tagColor}`}>{tagCategory}</span>
                    <div class="infra-logo-wrap" style={logoBoxStyle(logo)}>
                      {logo.type === "img" && <img class="infra-logo" src={logo.src} alt="" loading="lazy" />}
                      {logo.type === "svg" && <span class="infra-logo-icon" set:html={logo.markup} />}
                      {logo.type === "icon" && (
                        <span class="infra-logo-icon" style={`color:${logo.color}`} set:html={ICONS[logo.key]} />
                      )}
                    </div>
                    <h4><a class="infra-card-link" href={infra.url} target="_blank" rel="noopener">{infra.name}</a></h4>
                    <p>{cardDescription(infra.function)}</p>
                    <details class="infra-details">
                      <summary class="btn btn-outline registry-toggle">Show details</summary>
                      <div class="registry-card-details">
                        {isPublishing ? (
                          <>
                            <h4>Currently captures credit for</h4>
                            {infra.activeFor.length > 0 ? (
                              <ul class="infra-focus-list">
                                {infra.activeFor.map((ref) => (
                                  <li><strong>{ref.artefact}</strong> ({ref.category})</li>
                                ))}
                                {infra.id === "zenodo" && (
                                  <li><strong>Host for digital NTOs</strong> (General)</li>
                                )}
                              </ul>
                            ) : (
                              <p class="infra-focus-empty">No active mappings yet.</p>
                            )}
                          </>
                        ) : (
                          <>
                            <h4>Applicability &amp; usability</h4>
                            <p class="infra-usability">{infra.usability}</p>
                          </>
                        )}
                      </div>
                    </details>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section section-subtle infra-tier-section">
    <div class="container">
      <p class="eyebrow infra-eyebrow-intermediary">Intermediary</p>
      <h2 class="section-heading-left">Intermediary Infrastructure</h2>
      <p class="section-intro-left">
        The layer that sits between raw publishing and the researcher's profile: aggregating
        records to avoid double-counting, enriching them with quality context, tracking granular
        ongoing labour, and providing the shared vocabularies that let all of the above interoperate.
      </p>

      {intermediarySections.map((key) => {
        const meta = FUNCTION_META[key];
        const items = bySection.get(key) ?? [];
        return (
          <div class="infra-subsection infra-subsection-intermediary" id={meta.anchor}>
            <h3 class="infra-subsection-title">{meta.title}</h3>
            <p class="infra-subsection-blurb">{meta.blurb}</p>
            <div class="grid grid-3">
              {items.map((infra) => {
                const logo = LOGOS[infra.id];
                const tagCategory = NTO_CATEGORY[infra.id] ?? "General";
                const tagColor = `var(${CATEGORY_COLOR_VAR[tagCategory]})`;
                return (
                  <article class="card infra-card" id={infra.id} style={`border-color:${tagColor}`}>
                    <span class="badge badge-category infra-category-tag" style={`background:${tagColor}`}>{tagCategory}</span>
                    <div class="infra-logo-wrap" style={logoBoxStyle(logo)}>
                      {logo.type === "img" && <img class="infra-logo" src={logo.src} alt="" loading="lazy" />}
                      {logo.type === "svg" && <span class="infra-logo-icon" set:html={logo.markup} />}
                      {logo.type === "icon" && (
                        <span class="infra-logo-icon" style={`color:${logo.color}`} set:html={ICONS[logo.key]} />
                      )}
                    </div>
                    <h4><a class="infra-card-link" href={infra.url} target="_blank" rel="noopener">{infra.name}</a></h4>
                    <p>{cardDescription(infra.function)}</p>
                    <details class="infra-details">
                      <summary class="btn btn-outline registry-toggle">Show details</summary>
                      <div class="registry-card-details">
                        <h4>Applicability &amp; usability</h4>
                        <p class="infra-usability">{infra.usability}</p>
                      </div>
                    </details>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <h2>Know of infrastructure that should be here?</h2>
      <p>
        Propose a platform that captures credit for a non-traditional output type, under the
        relevant category, or suggest a correction to an existing entry.
      </p>
      <a class="btn btn-primary" href="https://github.com/BioComputingUP/nto-registry/issues/new?template=submit_infrastructure.yml" target="_blank" rel="noopener">
        Submit new infrastructure
      </a>
    </div>
  </section>

  <style>
    .infra-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .infra-hero-badge {
      flex-shrink: 0;
      width: 190px;
    }

    .infra-hero-badge svg {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 820px) {
      .infra-hero-badge {
        display: none;
      }
    }

    /* Matches the teal top-accent bar on the Intermediary subsection
       panels below, so the section eyebrow visually ties to them —
       Essential's eyebrow keeps the site-wide default accent colour,
       which already matches its own subsection panels' orange bar. */
    .infra-eyebrow-intermediary {
      color: var(--color-teal-500);
    }

    /* The credit-capture pipeline. Reads left to right: an essential block at
       each end (an output's first PID, and the profile that finally represents
       it), with the intermediary services that carry the record between them in
       the middle. Ontologies sits *under* the three sequential steps rather than
       among them — it's the semantic substrate they all depend on, not a stage
       in the flow, so it gets a dashed border and no top accent bar. Replaces
       the old .infra-jumpnav, which linked the same six anchors with less
       information. */
    .infra-pipeline-section {
      padding-top: var(--space-6);
    }

    .infra-pipeline {
      display: flex;
      align-items: stretch;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }

    .infra-pipeline-block,
    .infra-pipeline-chip,
    .infra-pipeline-substrate {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-3);
      text-align: center;
      text-decoration: none;
      color: var(--color-text);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .infra-pipeline-block:hover,
    .infra-pipeline-chip:hover,
    .infra-pipeline-substrate:hover {
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }

    /* Same 4px top accent bar idiom as the .infra-subsection panels below, so
       the diagram and the sections it points at share one colour language. */
    .infra-pipeline-block::before,
    .infra-pipeline-chip::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 4px;
    }

    .infra-pipeline-block::before {
      background: var(--color-accent);
    }

    .infra-pipeline-chip::before {
      background: var(--color-teal-500);
    }

    .infra-pipeline-block {
      flex: 1 1 0;
      min-width: 0;
    }

    .infra-pipeline-middle {
      display: flex;
      flex: 2.6 1 0;
      min-width: 0;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
    }

    .infra-pipeline-chain {
      display: flex;
      align-items: stretch;
      justify-content: center;
      gap: var(--space-2);
      width: 100%;
    }

    .infra-pipeline-chip {
      flex: 1 1 0;
      min-width: 0;
      padding: var(--space-3) var(--space-2);
    }

    .infra-pipeline-substrate {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      padding: var(--space-3);
      background: var(--color-bg-subtle);
      border-style: dashed;
      border-color: var(--color-teal-500);
    }

    .infra-pipeline-substrate-note {
      flex-basis: 100%;
      font-size: 0.8rem;
      color: var(--color-text-muted);
    }

    /* Tier membership is spelled out, not conveyed by colour alone. */
    .infra-pipeline-tier {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.15rem 0.55rem;
      border-radius: var(--radius-full);
      color: #fff;
      background: var(--color-accent);
    }

    .infra-pipeline-tier-intermediary {
      background: var(--color-teal-500);
    }

    /* The essential blocks carry their tier pill inside the block, because each
       is a single component. The intermediary pill instead labels the whole
       middle group, so it's left-aligned rather than centred over one chip. */
    .infra-pipeline-middle > .infra-pipeline-tier {
      align-self: flex-start;
    }

    .infra-pipeline-name {
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.3;
      text-wrap: balance;
    }

    .infra-pipeline-block .infra-pipeline-icon {
      color: var(--color-accent);
    }

    .infra-pipeline-chip .infra-pipeline-icon,
    .infra-pipeline-substrate .infra-pipeline-icon {
      color: var(--color-teal-500);
    }

    .infra-pipeline-icon :global(svg) {
      width: 26px;
      height: 26px;
    }

    .infra-pipeline-arrow {
      align-self: center;
      flex-shrink: 0;
      color: var(--color-text-muted);
    }

    .infra-pipeline-arrow :global(svg) {
      width: 22px;
      height: 22px;
    }

    .infra-pipeline-arrow-sm :global(svg) {
      width: 16px;
      height: 16px;
    }

    /* The flow turns vertical before the blocks get too narrow to read; the
       inner chain holds out longer since its chips are shorter. */
    @media (max-width: 980px) {
      .infra-pipeline {
        flex-direction: column;
      }

      /* The flex ratios above size along the main axis, which is now the
         height — leaving them in place collapses each block to a zero-height
         strip and `overflow: hidden` clips its label away. */
      .infra-pipeline-block,
      .infra-pipeline-middle {
        flex: 0 0 auto;
        width: 100%;
      }

      .infra-pipeline-arrow {
        transform: rotate(90deg);
      }
    }

    @media (max-width: 640px) {
      .infra-pipeline-chain {
        flex-direction: column;
      }

      /* Same main-axis reset as the blocks above — without it the chips
         collapse to zero-height strips once the chain turns vertical. */
      .infra-pipeline-chip {
        flex: 0 0 auto;
      }

      .infra-pipeline-arrow-sm {
        transform: rotate(90deg);
      }
    }

    .infra-tier-section {
      padding-top: var(--space-6);
    }

    .section-heading-left {
      margin-bottom: var(--space-2);
    }

    .section-intro-left {
      color: var(--color-text-muted);
      font-size: 1.1rem;
      max-width: 980px;
      margin-bottom: var(--space-7);
    }

    /* Each subsection is its own bordered, rounded panel with a coloured
       top accent bar — matching the Essential/Intermediary colour-coding
       already used in the jump-nav — so it reads as a visually distinct
       group of resources rather than just another heading in a long list.
       Panel fill alternates against its tier section's own background
       (Essential tier is plain white, Intermediary tier is tinted grey via
       .section-subtle) so the panel always has contrast either way. */
    .infra-subsection {
      scroll-margin-top: 6.5rem;
      position: relative;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6) var(--space-6) var(--space-7);
      overflow: hidden;
    }

    .infra-subsection::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
    }

    .infra-subsection-essential {
      background: var(--color-bg-subtle);
    }

    .infra-subsection-essential::before {
      background: var(--color-accent);
    }

    .infra-subsection-intermediary {
      background: var(--color-surface);
    }

    .infra-subsection-intermediary::before {
      background: var(--color-teal-500);
    }

    .infra-subsection + .infra-subsection {
      margin-top: var(--space-7);
    }

    .infra-subsection-title {
      margin-bottom: var(--space-2);
    }

    .infra-subsection-blurb {
      color: var(--color-text-muted);
      max-width: 980px;
      margin-bottom: var(--space-5);
    }

    .grid-3 {
      grid-template-columns: repeat(auto-fit, minmax(260px, 340px));
    }

    .infra-card {
      border-width: 2px;
      position: relative;
      scroll-margin-top: 6.5rem;
    }

    /* The intermediary panel fill is white (to contrast with its own
       Intermediary-tier section background), so cards inside it need the
       subtle-tint fill instead of the default white .card background —
       otherwise they'd blend into the panel with only their border
       showing. Essential-tier panels are already the subtle tint, so
       their cards keep the default white fill and don't need this. */
    .infra-subsection-intermediary .infra-card {
      background: var(--color-bg-subtle);
    }

    .infra-category-tag {
      align-self: flex-start;
      margin-bottom: var(--space-3);
    }

    .infra-logo-wrap {
      width: 72px;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      margin-bottom: var(--space-3);
    }

    .infra-logo {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: var(--radius-sm);
    }

    .infra-logo-icon {
      display: inline-flex;
    }

    .infra-logo-icon :global(svg) {
      width: 52px;
      height: 52px;
    }

    .infra-card h4 {
      margin-bottom: var(--space-2);
    }

    /* Whole-card click target: the title link grows an invisible overlay
       covering the entire card (the "stretched link" pattern), so clicking
       anywhere on the card opens the platform's site — not just the title
       text. The "Show details" toggle sits on its own stacking layer above
       that overlay so it keeps working as a separate, non-navigating click. */
    .infra-card-link::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .infra-card:hover {
      cursor: pointer;
    }

    .infra-details {
      position: relative;
      z-index: 1;
      margin-top: auto;
      padding-top: var(--space-3);
    }

    .infra-details summary {
      list-style: none;
      cursor: pointer;
    }

    .infra-details summary::-webkit-details-marker {
      display: none;
    }

    .infra-details summary::marker {
      content: "";
    }

    .infra-details[open] summary {
      margin-bottom: var(--space-3);
    }

    .cta-section {
      text-align: center;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .cta-inner {
      max-width: 600px;
      margin: 0 auto;
    }
  </style>
</BaseLayout>
