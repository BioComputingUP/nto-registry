---
import BaseLayout from "../layouts/BaseLayout.astro";
import stats from "../generated/stats.json";
import { ICONS } from "../lib/icons";

const base = import.meta.env.BASE_URL;

const features = [
  {
    href: "registry",
    title: "Registry",
    body: "Filter all 24 artefact types across Data, Training, Software, Research support, and Peer review.",
    icon: "layers",
  },
  {
    href: "reforms",
    title: "Assessment Reforms",
    body: "DORA, the Leiden Manifesto, the Hong Kong Principles, Hidden REF, and CoARA.",
    icon: "flag",
  },
  {
    href: "infrastructure",
    title: "Infrastructure",
    body: "APICURON, ORCID, bio.tools, Zenodo, and the platforms that capture NTRA credit.",
    icon: "server",
  },
  {
    href: "about",
    title: "About",
    body: "The preprint behind this registry, its authors, and the ELIXIR community.",
    icon: "info",
  },
];

const statTiles = [
  { value: stats.artefactCount, label: "Artefact types", icon: "layers" },
  { value: stats.categoryCount, label: "Categories", icon: "grid" },
  { value: stats.infrastructureCount, label: "Infrastructure platforms", icon: "server" },
  { value: stats.reformInitiativeCount, label: "Reform initiatives", icon: "flag" },
];

const categoryIcons: Record<string, string> = {
  Data: "database",
  Training: "cap",
  Software: "code",
  "Research support": "document",
  "Peer review": "check",
};
---

<BaseLayout title="Home" description="A versioned, community-extensible catalogue of Non-Traditional Research Artefacts (NTRAs) in the Life Sciences.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Life Sciences Focused</p>
        <h1>The Non-Traditional Research Artefact <span class="hero-acronym">(NTRA)</span> Registry</h1>
        <p class="hero-subtitle">Credit, recognition, and reward for the work that sustains modern science.</p>
        <p class="hero-lead">
          Publications alone don't capture the curated datasets, research software, training
          materials, research support, and peer review that sustain modern life science. This
          registry catalogues those artefacts — versioned, machine-readable, and open for the
          community to extend. It's also built to support policymakers and higher education
          institutions adopting alternative research assessment for NTRAs.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`${base}registry/`}>Explore the Registry</a>
          <a class="btn btn-outline hero-btn-outline" href={`${base}about/`}>Read the paper</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 460 420" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <circle cx="345" cy="90" r="140" fill="var(--color-teal-500)" opacity="0.16" />
          <circle cx="100" cy="330" r="120" fill="var(--color-accent)" opacity="0.14" />

          <!-- Data tile -->
          <g transform="translate(28,34) rotate(-6)">
            <rect width="108" height="108" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)" />
            <g transform="translate(30,30)" stroke="var(--color-teal-500)" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M0 4C0 1.8 5.4 0 12 0s12 1.8 12 4-5.4 4-12 4-12-1.8-12-4Zm0 0v18c0 2.2 5.4 4 12 4s12-1.8 12-4V4M0 13c0 2.2 5.4 4 12 4s12-1.8 12-4" />
            </g>
          </g>

          <!-- Software tile -->
          <g transform="translate(216,6) rotate(4)">
            <rect width="118" height="118" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)" />
            <g transform="translate(29,34)" stroke="var(--color-orange-500)" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 0 3 12l12 12M29 0l12 12-12 12" />
            </g>
          </g>

          <!-- Training tile -->
          <g transform="translate(308,168) rotate(-3)">
            <rect width="106" height="106" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)" />
            <g transform="translate(20,30)" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.92">
              <path d="M0 11 33 0l33 11-33 11L0 11Zm13 7v11c0 3 9 6 20 6s20-3 20-6V18" />
            </g>
          </g>

          <!-- Research support tile -->
          <g transform="translate(54,224) rotate(5)">
            <rect width="108" height="108" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)" />
            <g transform="translate(32,26)" stroke="var(--color-teal-500)" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 0h20l14 14v38a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V3a3 3 0 0 1 3-3Zm20 0v14h14M8 30h28M8 40h20M8 20h6" />
            </g>
          </g>

          <!-- Peer review tile -->
          <g transform="translate(222,268) rotate(-4)">
            <rect width="118" height="118" rx="18" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.18)" />
            <g transform="translate(33,34)" stroke="var(--color-orange-500)" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M50 25a25 25 0 1 1-10.3-20.3" />
              <path d="M20 25l7 7 14-16" />
            </g>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-4 stats-row">
        {statTiles.map((tile) => (
          <div class="stat-tile card">
            <span class="stat-icon" set:html={ICONS[tile.icon]} />
            <div class="stat-number">{tile.value}</div>
            <div class="stat-label">{tile.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-subtle">
    <div class="container">
      <h2 class="ntra-def-heading">What is a Non-Traditional Research Artefact (NTRA)?</h2>
      <p class="section-intro ntra-def-intro">
        A Non-Traditional Research Artefact is any output or activity that sustains modern
        research but is systematically under-represented in publication-centric assessment —
        from a curated database entry to a FAIR software release to a grant peer-review
        report. This registry gives each type a shared definition, real examples, and a path
        to credit capture.
      </p>
      <div class="grid grid-4 category-chips">
        {stats.categories.map((category) => (
          <div class="card category-chip">
            <span class="badge badge-category">
              <span class="category-chip-icon" set:html={ICONS[categoryIcons[category] ?? "grid"]} />
              {category}
            </span>
          </div>
        ))}
        <div class="card category-chip category-chip-more">
          <span class="chip-plus" aria-hidden="true">+</span>
          <span class="chip-more-label">More to come</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-heading-left">Browse the registry</h2>
      <p class="section-intro-left">Four ways into the same versioned dataset — all sourced live from&nbsp;this&nbsp;repository's&nbsp;YAML.</p>
      <div class="grid grid-4 feature-grid">
        {features.map((feature) => (
          <a class="card feature-card" href={`${base}${feature.href}/`}>
            <div class="feature-card-head">
              <span class="feature-icon" set:html={ICONS[feature.icon]} />
              <h3>{feature.title}</h3>
            </div>
            <p>{feature.body}</p>
            <span class="feature-link">Explore &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <h2>Missing something?</h2>
      <p>Propose a new example, artefact type, infrastructure platform, or reform initiative.</p>
      <a class="btn btn-primary" href="https://github.com/gavinf97/ntra-registry/issues/new/choose" target="_blank" rel="noopener">
        Submit on GitHub
      </a>
    </div>
  </section>

  <style>
    .hero {
      background: linear-gradient(135deg, var(--color-navy-800), var(--color-navy-900));
      color: #fff;
      padding: var(--space-8) 0;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-7);
      align-items: center;
    }

    .hero .eyebrow {
      color: var(--color-teal-500);
    }

    .hero h1 {
      color: #fff;
      margin-bottom: var(--space-3);
    }

    .hero-acronym {
      color: var(--color-teal-500);
    }

    .hero-subtitle {
      font-size: 1.3rem;
      color: rgba(255, 255, 255, 0.92);
      font-weight: 500;
      margin-bottom: var(--space-4);
    }

    .hero-lead {
      font-size: 1.05rem;
      color: rgba(255, 255, 255, 0.8);
      max-width: 620px;
    }

    .hero-actions {
      display: flex;
      gap: var(--space-4);
      flex-wrap: wrap;
      margin-top: var(--space-6);
    }

    .hero-btn-outline {
      color: #fff;
      border-color: rgba(255, 255, 255, 0.6);
    }

    .hero-btn-outline:hover {
      background: #fff;
      color: var(--color-navy-800);
    }

    .hero-art svg {
      width: 100%;
      height: auto;
      max-width: 460px;
      margin: 0 auto;
      display: block;
    }

    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }

      .hero-art {
        display: none;
      }
    }

    .stat-tile {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: var(--space-6) var(--space-4);
    }

    .stat-icon {
      color: var(--color-accent);
      margin-bottom: var(--space-3);
    }

    .stat-icon :global(svg) {
      width: 30px;
      height: 30px;
    }

    .ntra-def-heading,
    .ntra-def-intro {
      text-align: center;
    }

    .ntra-def-intro {
      margin-left: auto;
      margin-right: auto;
    }

    .category-chips {
      margin-top: var(--space-6);
    }

    .category-chip {
      text-align: center;
      padding: var(--space-4);
    }

    .category-chip-icon {
      display: inline-flex;
      vertical-align: -3px;
    }

    .category-chip-icon :global(svg) {
      width: 15px;
      height: 15px;
    }

    .category-chip-more {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-1);
      border-style: dashed;
      background: transparent;
      box-shadow: none;
    }

    .chip-plus {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--color-accent);
      line-height: 1;
    }

    .chip-more-label {
      font-size: var(--fs-small);
      color: var(--color-text-muted);
    }

    .section-heading-left {
      margin-bottom: var(--space-2);
    }

    .section-intro-left {
      color: var(--color-text-muted);
      font-size: 1.1rem;
      max-width: 640px;
      margin-bottom: var(--space-7);
    }

    .feature-grid {
      align-items: stretch;
    }

    .feature-card {
      color: var(--color-text);
      display: flex;
      flex-direction: column;
    }

    .feature-card:hover {
      text-decoration: none;
      transform: translateY(-3px);
    }

    .feature-card-head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .feature-icon {
      color: var(--color-accent);
      display: inline-flex;
      flex-shrink: 0;
    }

    .feature-icon :global(svg) {
      width: 26px;
      height: 26px;
    }

    .feature-card h3 {
      color: var(--color-heading);
      margin: 0;
    }

    .feature-link {
      margin-top: auto;
      padding-top: var(--space-3);
      color: var(--color-accent);
      font-weight: 600;
    }

    .cta-section {
      text-align: center;
      background: var(--color-bg-subtle);
      border-top: 1px solid var(--color-border);
    }

    .cta-inner {
      max-width: 600px;
    }
  </style>
</BaseLayout>
