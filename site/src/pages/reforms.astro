---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ICONS, WHITE_ICONS } from "../lib/icons";
import reforms from "../generated/reform-initiatives.json";

const sorted = [...reforms].sort((a, b) => a.year - b.year);
---

<BaseLayout title="Assessment Reforms" description="Key international research assessment reform initiatives supporting non-traditional outputs.">
  <section class="section page-header-section">
    <div class="container">
      <div class="reforms-title-row">
        <div>
          <p class="eyebrow">Policy landscape</p>
          <h1>Research Assessment Reforms</h1>
          <p class="section-intro" style="margin-left:0;">
            The international reform movement this registry builds on — each initiative's core
            philosophy and its specific relevance to recognising non-traditional
            outputs. This list is non-exhaustive: it highlights efforts most relevant to the
            Life Sciences and this work, included here for context on the wider international
            and global reform movement.
          </p>
        </div>
        <div class="reforms-hero-badge" aria-hidden="true">
          <svg viewBox="0 0 260 240" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <circle cx="196" cy="56" r="52" fill="var(--color-teal-500)" opacity="0.14" />
            <circle cx="44" cy="184" r="40" fill="var(--color-accent)" opacity="0.12" />
            <circle cx="232" cy="192" r="20" fill="var(--color-teal-500)" opacity="0.18" />
            <circle cx="18" cy="26" r="16" fill="var(--color-navy-700)" opacity="0.1" />

            <g transform="translate(34,24)">
              <rect width="192" height="192" rx="30" fill="var(--color-surface)" stroke="var(--color-border)" />
              <g transform="translate(48,48) scale(4)" stroke="var(--color-accent)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 3v18" />
                <path d="M5 4h13l-3 4 3 4H5" />
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section reforms-table-section">
    <div class="container">
      <div class="reforms-table-wrap">
        <table class="reforms-table">
          <thead>
            <tr>
              <th scope="col">Initiative</th>
              <th scope="col">Year</th>
              <th scope="col">Core philosophy</th>
              <th scope="col">Relevance to non-traditional outputs</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((r) => (
              <tr class="reforms-row">
                <th scope="row">
                  <a href={r.url} target="_blank" rel="noopener" class="initiative-link">
                    {r.initiative}
                    <span class="initiative-link-icon" set:html={ICONS["external-link"]} />
                  </a>
                </th>
                <td>{r.year}</td>
                <td>{r["core-philosophy"]}</td>
                <td>{r["relevance-to-ntos"]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-inner">
      <h2>Know of another reform initiative?</h2>
      <p>Suggest it for inclusion in this list, or propose a correction to an existing one.</p>
      <a class="btn btn-primary" href="https://github.com/BioComputingUP/nto-registry/issues/new?template=submit_reform.yml" target="_blank" rel="noopener">
        <span class="btn-icon" set:html={WHITE_ICONS.plus} />
        Suggest a reform initiative
      </a>
    </div>
  </section>

  <style>
    .reforms-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .reforms-hero-badge {
      flex-shrink: 0;
      width: 190px;
    }

    .reforms-hero-badge svg {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 820px) {
      .reforms-hero-badge {
        display: none;
      }
    }

    .reforms-table-wrap {
      margin-top: var(--space-2);
    }

    .reforms-table thead th {
      background: var(--color-navy-900);
      color: #fff;
      border-bottom: none;
    }

    /* Alternating column tint (not row zebra-striping) so each column reads
       as a distinct band — column 1 (Initiative) and column 3 (Core
       philosophy) share a tint, column 2 (Year) and column 4 (Relevance)
       share the other. Uses color-mix against the theme's own surface
       color (rather than two already-similar neutral tokens) so the two
       bands are clearly distinguishable in both light and dark mode. */
    .reforms-table tbody th:nth-child(1),
    .reforms-table tbody td:nth-child(1),
    .reforms-table tbody th:nth-child(3),
    .reforms-table tbody td:nth-child(3) {
      background: var(--color-surface);
    }

    .reforms-table tbody th:nth-child(2),
    .reforms-table tbody td:nth-child(2),
    .reforms-table tbody th:nth-child(4),
    .reforms-table tbody td:nth-child(4) {
      background: color-mix(in srgb, var(--color-teal-500) 12%, var(--color-surface));
    }

    /* Whole-row click target: the initiative link grows an invisible
       overlay covering the entire row (the "stretched link" pattern), so
       clicking anywhere in the row — not just the initiative name — opens
       it. The row itself gets a hover background and the link an
       external-link icon + underline so it's clear up front the row is
       clickable, not just discoverable by accident. */
    .reforms-row {
      position: relative;
      cursor: pointer;
    }

    /* Extra `.reforms-table tbody` prefix isn't structurally necessary but
       bumps specificity above the column-tint nth-child rules above, which
       would otherwise win over a plainer `.reforms-row:hover td` selector
       and hide the hover state on 3 of every 4 cells. */
    .reforms-table tbody tr.reforms-row:hover th,
    .reforms-table tbody tr.reforms-row:hover td,
    .reforms-table tbody tr.reforms-row:focus-within th,
    .reforms-table tbody tr.reforms-row:focus-within td {
      background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    }

    .initiative-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-heading);
      font-weight: 700;
      text-decoration: none;
    }

    /* No positioned ancestor between this pseudo-element and .reforms-row
       (the <tr>), so `inset: 0` sizes against the row's own box — the
       overlay covers every cell, not just the <th> this link lives in. */
    .initiative-link::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .reforms-row:hover .initiative-link,
    .initiative-link:focus-visible {
      text-decoration: underline;
    }

    .initiative-link-icon {
      display: inline-flex;
      flex-shrink: 0;
      color: var(--color-text-muted);
      opacity: 0.7;
      transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .initiative-link-icon :global(svg) {
      width: 14px;
      height: 14px;
    }

    .reforms-row:hover .initiative-link-icon {
      color: var(--color-accent);
      opacity: 1;
      transform: translate(1px, -1px);
    }

    .btn-icon {
      display: inline-flex;
    }

    .btn-icon :global(svg) {
      width: 18px;
      height: 18px;
    }

    .cta-section {
      text-align: center;
      background: var(--color-bg-subtle);
      border-top: 1px solid var(--color-border);
    }

    .cta-inner {
      max-width: 600px;
      margin: 0 auto;
    }
  </style>
</BaseLayout>
